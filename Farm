local function missionHasModule(id)
	for _, m in ipairs(MISSIONS[state.mission].mods) do
		if m == id then return true end
	end
	return false
end
local function missionKind()
	local l, g = missionHasModule("lixo"), missionHasModule("grama")
	if l and g then return "ambos" elseif g then return "grama" elseif l then return "lixo" end
	return nil
end
local function missionStatusText(m)
	local avail, pend = {}, {}
	for _, id in ipairs(m.mods) do
		local mod = MODULES[id]
		if mod.available then avail[#avail + 1] = mod.label else pend[#pend + 1] = mod.label end
	end
	local t = {}
	if #avail > 0 then t[#t + 1] = "Disponível: " .. table.concat(avail, ", ") .. "." end
	if #pend > 0 then t[#t + 1] = "Em breve: " .. table.concat(pend, ", ") .. "." end
	t[#t + 1] = "Nada roda sem você iniciar."
	return table.concat(t, " ")
end

