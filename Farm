----------------------------------------------------------------------
-- UTILITÁRIOS
----------------------------------------------------------------------
local function short(s, n) s = tostring(s); n = n or 60; return #s > n and (s:sub(1, n - 3) .. "...") or s end
local function viewport()
	local cam = Workspace.CurrentCamera
	return cam and cam.ViewportSize or Vector2.new(800, 400)
end
local function posOf(inst, depth)
	depth = depth or 0
	local ok, p = pcall(function()
		if inst:IsA("BasePart") then return inst.Position end
		if inst:IsA("Model") then return inst:GetPivot().Position end
		if depth < 2 and inst.Parent and inst:IsA("ProximityPrompt") then return posOf(inst.Parent, depth + 1) end
		return nil
	end)
	if ok then return p end
	return nil
end
local function newMaid()
	local m = { items = {} }
	function m:add(x) self.items[#self.items + 1] = x return x end
	function m:clean()
		for _, x in ipairs(self.items) do
			pcall(function()
				if typeof(x) == "RBXScriptConnection" then x:Disconnect()
				elseif typeof(x) == "Instance" then x:Destroy()
				elseif type(x) == "function" then x() end
			end)
		end
		self.items = {}
	end
	return m
end

----------------------------------------------------------------------
-- FARM
-- Workspace.Map.Sistemas.Jobs["Recolher Lixo"].Lixos / .Lixeiras
-- Workspace.Map.Sistemas.Jobs["Cortar Grama"].Foice (loja) / .Gramas (atributo Ativo)
-- Workspace.Map.Sistemas.Jobs.Caixas (prompt "Pegar") -> Tool "Caixa" -> entrega na área marcada
----------------------------------------------------------------------
local Farm = {
	running = false, mods = {}, quota = {}, idx = 1, done = 0, fails = 0, curMod = nil, lastNotifT = 0, buyMsg = nil,
	action = "parado", note = nil, noteMod = nil, notified = {}, black = {}, skipUntil = {},
	stats = { coletados = 0, depositados = 0, cortadas = 0, caixas = 0 },
}
do
local farmGen = 0
local originalHold, originalLOS = {}, {}
local farmMaid = newMaid()
local noBuyUntil = 0

local function jobFolder(key)
	local cur = Workspace
	for _, n in ipairs({ "Map", "Sistemas", "Jobs", JOBS[key] }) do
		cur = cur and cur:FindFirstChild(n)
	end
	return cur
end
local function farmRoot()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
-- procura a Tool pelo nome exato; se não achar, aceita nome que contenha o texto (ex.: "Foice Enferrujada")
local function findTool(name)
	local low = name:lower()
	local function scan(container)
		if not container then return nil end
		local exact = container:FindFirstChild(name)
		if exact and exact:IsA("Tool") then return exact end
		for _, t in ipairs(container:GetChildren()) do
			if t:IsA("Tool") and t.Name:lower():find(low, 1, true) then return t end
		end
		return nil
	end
	local t = scan(LocalPlayer.Character)
	if t then return t, true end
	t = scan(LocalPlayer:FindFirstChildOfClass("Backpack"))
	if t then return t, false end
	return nil, false
end
local function moneyStr()
	local ls = LocalPlayer:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild("Dinheiro")
	return v and tostring(v.Value) or ""
end
local function teleportTo(pos, lift)
	local hrp = farmRoot()
	if not hrp or not pos then return false end
	return pcall(function()
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(pos + Vector3.new(0, lift or 3, 0))
	end)
end

-- INSTANT INTERACT: HoldDuration = 0 e sem linha de visão (restaurado ao parar)
local function makeInstant(p)
	if typeof(p) ~= "Instance" or not p:IsA("ProximityPrompt") then return end
	pcall(function()
		if originalHold[p] == nil then originalHold[p] = p.HoldDuration end
		if originalLOS[p] == nil then originalLOS[p] = p.RequiresLineOfSight end
		p.HoldDuration = 0
		p.RequiresLineOfSight = false
	end)
end
local function enableInstant(job)
	for _, d in ipairs(job:GetDescendants()) do makeInstant(d) end
	farmMaid:add(job.DescendantAdded:Connect(makeInstant))
end
local function triggerPrompt(p)
	makeInstant(p)
	task.spawn(function()
		if type(fireproximityprompt) == "function" then pcall(fireproximityprompt, p) end
	end)
end
local function triggerFallback(p)
	task.spawn(function()
		pcall(function() p:InputHoldBegin(); task.wait(); p:InputHoldEnd() end)
	end)
end
local function waitFor(cond, timeout, alive)
	local t0 = os.clock()
	while alive() and os.clock() - t0 < timeout do
		if cond() then return true end
		task.wait(0.03)
	end
	return cond()
end
local function collectPrompts(container, needActive)
	local out, now = {}, os.clock()
	if not container then return out end
	for _, d in ipairs(container:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled then
			local part, bl = d.Parent, Farm.black[d]
			if not (bl and bl > now) and part and part:IsA("BasePart") then
				if not needActive or (part:GetAttribute("Ativo") ~= false and part.Transparency < 1) then
					out[#out + 1] = d
				end
			end
		end
	end
	return out
end
local function nearest(list, from)
	local best, bd
	for _, p in ipairs(list) do
		local pos = posOf(p)
		if pos then
			local d = (pos - from).Magnitude
			if not bd or d < bd then best, bd = p, d end
		end
	end
	return best
end
-- teleporta, aciona e confirma (≈0.5s); true se confirmou
local function interact(p, doneFn, alive)
	local t0 = os.clock()
	teleportTo(posOf(p))
	task.wait(0.08)
	triggerPrompt(p)
	local done = waitFor(doneFn, 0.25, alive)
	if not done and alive() then
		triggerFallback(p)
		done = waitFor(doneFn, 0.3, alive)
	end
	-- falhou e o jogo mostrou uma notificação durante a tentativa = provável cooldown
	if not done and alive() and Farm.lastNotifT >= t0 - 0.2 then Farm.notify(Farm.curMod) end
	return done
end

----------------------------------------------------------------------
-- AVISO DE COOLDOWN (igual para lixo, grama e caixa)
-- No máximo NOTICE_MAX aviso por farm iniciado; só volta a avisar depois de parar e iniciar de novo.
----------------------------------------------------------------------
function Farm.notify(kind)
	if not kind then return end
	-- Ambos/Todos se comportam como um só: um único contador compartilhado
	local key = (#Farm.mods > 1) and "_misto" or kind
	local s = Farm.notified[key]
	if not s then s = { n = 0, t = -100 }; Farm.notified[key] = s end
	local now = os.clock()
	if s.n >= CFG.NOTICE_MAX or now - s.t < CFG.NOTICE_GAP then return end
	s.n += 1
	s.t = now
	if Farm.onNotify then pcall(Farm.onNotify, kind) end
end
function Farm.resetNotify(kind)
	-- não zera mais: cada bloco avisa só 1 vez até o farm ser parado (Farm.start limpa a lista)
	return
end
function Farm.restoreHold()
	for p, v in pairs(originalHold) do pcall(function() p.HoldDuration = v end) end
	for p, v in pairs(originalLOS) do pcall(function() p.RequiresLineOfSight = v end) end
	originalHold, originalLOS = {}, {}
end
function Farm.stop()
	farmGen += 1
	Farm.running = false
	Farm.action = "parado"
	farmMaid:clean()
	Farm.restoreHold()
end

-- LIXO
local function unavailable(msg)
	Farm.action = msg
	if #Farm.mods > 1 then return false end -- em modo misto, pula para o próximo módulo
	task.wait(0.5)
	return true
end
local function trashStep(job, hrp, alive)
	if findTool("Lixo") then
		local bin = nearest(collectPrompts(job:FindFirstChild("Lixeiras"), false), hrp.Position)
		if not bin then return unavailable("sem lixeira disponível") end
		Farm.action = "guardando lixo"
		if interact(bin, function() return findTool("Lixo") == nil end, alive) then
			Farm.stats.depositados += 1
			Farm.resetNotify("lixo")
		else
			Farm.black[bin] = os.clock() + 2
		end
	else
		local pr = nearest(collectPrompts(job:FindFirstChild("Lixos"), true), hrp.Position)
		if not pr then return unavailable("procurando lixo ativo") end
		Farm.action = "pegando lixo"
		if interact(pr, function() return findTool("Lixo") ~= nil end, alive) then
			Farm.stats.coletados += 1
			Farm.resetNotify("lixo")
		else
			Farm.black[pr] = os.clock() + 5
		end
	end
	return true
end

-- GRAMA (compra a foice se não tiver)
local MULT = { K = 1e3, M = 1e6, B = 1e9 }
-- converte "2500", "2.500", "2,500", "2.5K", "1M" em número (nunca dá erro)
local function parseAmount(s)
	if type(s) == "number" then return s end
	if s == nil then return nil end
	s = tostring(s):upper()
	local num, suf = s:match("([%d%.,]+)%s*([KMB]?)")
	if not num then return nil end
	if suf == "" then
		num = num:gsub("[%.,]", "") -- sem sufixo: pontos/vírgulas são separador de milhar
	else
		num = num:gsub(",", ".")
	end
	local n = tonumber(num)
	if not n then return nil end
	return n * (MULT[suf] or 1)
end
local function parseMoney()
	local ls = LocalPlayer:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild("Dinheiro")
	if not v then return nil end
	return parseAmount(v.Value)
end
local function shopPrice(pr)
	for _, s in ipairs({ tostring(pr.ActionText), tostring(pr.ObjectText) }) do
		local after = s:match("%$%s*([%d%.,]+%s*[KkMmBb]?)")
		local before = s:match("([%d%.,]+%s*[KkMmBb]?)%s*%$")
		local v = parseAmount(after or before)
		if v and v > 0 then return v end
	end
	return nil
end
local function findShopPrompt(job)
	local shop = job:FindFirstChild("Foice")
	local pr = shop and shop:FindFirstChildWhichIsA("ProximityPrompt", true)
	if pr then return pr end
	for _, d in ipairs(job:GetDescendants()) do
		if d:IsA("ProximityPrompt") and (tostring(d.ObjectText):find("Foice") or tostring(d.ActionText):find("Comprar")) then return d end
	end
	return nil
end
local function buyFail(msg, secs)
	noBuyUntil = os.clock() + (secs or 20)
	Farm.buyMsg = msg
	Farm.action = msg
	return false
end
local function ensureFoice(job, alive)
	if findTool("Foice") then return true end
	if os.clock() < noBuyUntil then Farm.action = Farm.buyMsg or "sem foice"; return false end
	local pr = findShopPrompt(job)
	if not pr then return buyFail("loja da foice não encontrada", 10) end
	local price = shopPrice(pr)
	local money = parseMoney()
	-- só bloqueia se souber o preço E o dinheiro; caso contrário tenta comprar mesmo assim
	if price and money and money + 100 < price then
		return buyFail("sem dinheiro p/ foice (" .. math.floor(price) .. "$)", 15)
	end
	Farm.action = "comprando foice"
	local function got() return findTool("Foice") ~= nil end
	local function goShop() teleportTo(posOf(pr)); task.wait(0.12) end
	-- 1) instantâneo (2 tentativas)
	for _ = 1, 2 do
		goShop()
		triggerPrompt(pr)
		if waitFor(got, 0.9, alive) then return true end
		if not alive() then return false end
	end
	-- 2) hold real (caso o servidor exija o tempo de hold)
	local hold = originalHold[pr] or 1
	pcall(function() pr.HoldDuration = hold end)
	goShop()
	task.spawn(function()
		pcall(function() pr:InputHoldBegin(); task.wait(hold + 0.15); pr:InputHoldEnd() end)
	end)
	local ok = waitFor(got, hold + 1.5, alive)
	pcall(function() pr.HoldDuration = 0 end)
	if ok then return true end
	if not alive() then return false end
	return buyFail("foice não comprada (sem resposta do servidor)", 20)
end
local function grassStep(job, hrp, alive)
	local okB, res = pcall(ensureFoice, job, alive)
	if not okB then return buyFail("erro na compra: " .. short(res, 40), 10) end
	if not res then return false end
	local tool, equipped = findTool("Foice")
	if tool and not equipped then
		Farm.action = "equipando foice"
		local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if hum then pcall(function() hum:EquipTool(tool) end) end
		task.wait(0.15)
	end
	local pr = nearest(collectPrompts(job:FindFirstChild("Gramas"), true), hrp.Position)
	if not pr then return unavailable("procurando grama ativa") end
	Farm.action = "cortando grama"
	local part = pr.Parent
	local function cut()
		return not pr:IsDescendantOf(Workspace) or part:GetAttribute("Ativo") == false or part.Transparency >= 1
	end
	if interact(pr, cut, alive) then
		Farm.stats.cortadas += 1
		Farm.resetNotify("grama")
	else
		Farm.black[pr] = os.clock() + 5
	end
	return true
end

-- CAIXA (pega no prompt e entrega na área marcada)
local function deliverBox(alive)
	local m0, t0 = moneyStr(), os.clock()
	for _, off in ipairs(CFG.DELIVERY_OFFSETS) do
		if not alive() then return end
		Farm.action = "entregando caixa"
		teleportTo(CFG.DELIVERY + off, 0)
		if waitFor(function() return findTool("Caixa") == nil or moneyStr() ~= m0 end, 0.5, alive) then
			Farm.stats.caixas += 1
			Farm.resetNotify("caixa")
			return
		end
	end
	if alive() and Farm.lastNotifT >= t0 - 0.2 then Farm.notify("caixa") end
	Farm.action = "entrega não confirmada"
	task.wait(1)
end
local function boxStep(job, hrp, alive)
	if findTool("Caixa") then
		deliverBox(alive)
		return true
	end
	local pr = nearest(collectPrompts(job, false), hrp.Position)
	if not pr then return unavailable("aguardando caixa (cooldown)") end
	Farm.action = "pegando caixa"
	if interact(pr, function() return findTool("Caixa") ~= nil end, alive) then
		Farm.resetNotify("caixa")
	else
		Farm.black[pr] = os.clock() + 2
		-- no modo misto não fica preso na caixa: segue para o próximo
		if #Farm.mods > 1 then
			Farm.action = "caixa em cooldown"
			return false
		end
	end
	return true
end

local function has(mod)
	for _, m in ipairs(Farm.mods) do if m == mod then return true end end
	return false
end
local function runMod(mod, hrp, alive)
	Farm.curMod = mod
	local job = jobFolder(mod)
	if not job then Farm.action = "trabalho '" .. JOBS[mod] .. "' não encontrado"; return false end
	if mod == "lixo" then return trashStep(job, hrp, alive) end
	if mod == "grama" then return grassStep(job, hrp, alive) end
	return boxStep(job, hrp, alive)
end
local function unitOf(mod)
	if mod == "lixo" then return Farm.stats.depositados end
	if mod == "grama" then return Farm.stats.cortadas end
	return Farm.stats.caixas
end
-- avança para o próximo módulo que não esteja em "pausa" (ex.: caixa em cooldown)
local function nextMod()
	local n, now = #Farm.mods, os.clock()
	local i = Farm.idx
	for _ = 1, n do
		i = i % n + 1
		if not ((Farm.skipUntil[Farm.mods[i]] or 0) > now) then break end
	end
	Farm.idx = i
	Farm.done = 0
end
-- Revezamento por cota: "Todos" = 3 lixos -> 4 gramas -> 1 caixa -> repete
local function farmStep(gen)
	local function alive() return Farm.running and farmGen == gen end
	local hrp = farmRoot()
	if not hrp then Farm.action = "aguardando personagem"; task.wait(0.5) return end
	local mods = Farm.mods
	local cur = mods[Farm.idx]
	-- módulo em pausa (caixa em cooldown): pula direto, a não ser que já esteja carregando a caixa
	if #mods > 1 and (Farm.skipUntil[cur] or 0) > os.clock() and not (cur == "caixa" and findTool("Caixa")) then
		nextMod()
		cur = mods[Farm.idx]
	end
	local mod = cur
	if has("lixo") and findTool("Lixo") then mod = "lixo"
	elseif has("caixa") and findTool("Caixa") then mod = "caixa" end
	local before = unitOf(mod)
	local ok = runMod(mod, hrp, alive)
	if ok == false then
		Farm.note, Farm.noteMod = Farm.action, mod
		if #mods > 1 then
			Farm.skipUntil[mod] = os.clock() + (mod == "caixa" and CFG.BOX_SKIP_SECS or 2)
			if mod == cur then nextMod() end
			Farm.fails += 1
			if Farm.fails >= #mods then Farm.fails = 0; task.wait(1) else task.wait(0.1) end
		else
			task.wait(1)
		end
		return
	end
	Farm.fails = 0
	if Farm.noteMod == mod then Farm.note, Farm.noteMod = nil, nil end
	if mod == "caixa" then Farm.skipUntil.caixa = nil end
	if mod == cur and unitOf(mod) > before then
		Farm.done += 1
		if Farm.done >= (Farm.quota[cur] or 1) then nextMod() end
	end
end

-- Detecção das notificações do jogo (qualquer RemoteEvent de aviso/notificação)
local COOLDOWN_WORDS = { "cooldown", "coldown", "cool down", "aguard", "espere", "espera", "tempo", "segundo",
	"recarreg", "calma", "devagar", "rápido", "rapido", "wait", "delay", "ainda não", "ainda nao" }
local function collectStrings(v, out, depth)
	if type(v) == "string" then
		out[#out + 1] = v:lower()
	elseif type(v) == "table" and depth < 3 then
		for _, x in pairs(v) do collectStrings(x, out, depth + 1) end
	end
end
local function kindOfText(text)
	if text:find("caixa", 1, true) or text:find("entrega", 1, true) then return "caixa" end
	if text:find("lixo", 1, true) or text:find("lixeira", 1, true) then return "lixo" end
	if text:find("grama", 1, true) or text:find("foice", 1, true) or text:find("cort", 1, true) then return "grama" end
	return Farm.curMod
end
local function onGameNotice(...)
	Farm.lastNotifT = os.clock()
	local args, count = { ... }, select("#", ...)
	pcall(function()
		local parts = {}
		for i = 1, count do collectStrings(args[i], parts, 0) end
		local text = table.concat(parts, " ")
		for _, w in ipairs(COOLDOWN_WORDS) do
			if text:find(w, 1, true) then
				Farm.notify(kindOfText(text))
				return
			end
		end
	end)
end

function Farm.start(mods, quota)
	if Farm.running then return false, "Farm já está ativo." end
	for _, m in ipairs(mods) do
		if not jobFolder(m) then return false, "Trabalho '" .. JOBS[m] .. "' não encontrado no mapa." end
	end
	farmGen += 1
	local gen = farmGen
	Farm.running = true
	Farm.mods = mods
	Farm.quota = quota or {}
	Farm.idx, Farm.done, Farm.fails = 1, 0, 0
	Farm.note, Farm.noteMod, Farm.notified, Farm.buyMsg, Farm.curMod = nil, nil, {}, nil, nil
	Farm.lastNotifT = 0
	Farm.stats = { coletados = 0, depositados = 0, cortadas = 0, caixas = 0 }
	Farm.black = {}
	Farm.skipUntil = {}
	Farm.action = "iniciando"
	noBuyUntil = 0
	farmMaid:clean()
	for _, m in ipairs(mods) do enableInstant(jobFolder(m)) end
	pcall(function()
		for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
			if d:IsA("RemoteEvent") then
				local n = d.Name:lower()
				if n:find("notif", 1, true) or n:find("aviso", 1, true) or n:find("alert", 1, true)
					or n:find("mensag", 1, true) or n:find("message", 1, true) then
					farmMaid:add(d.OnClientEvent:Connect(onGameNotice))
				end
			end
		end
	end)
	task.spawn(function()
		while Farm.running and farmGen == gen do
			local ok, err = pcall(farmStep, gen)
			if not ok then Farm.action = "erro: " .. short(err, 50); task.wait(1) end
			task.wait()
		end
	end)
	return true
end
end -- fim do escopo do farm

