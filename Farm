		local mouse = LocalPlayer:GetMouse()
		s.maid:add(UserInputService.InputBegan:Connect(function(input, gp)
			if s.closed then return end
			local t = input.UserInputType
			if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
			if gp then
				pcall(logUiClick, s, input, gui)
				return
			end
			local target = mouse.Target
			if not target then
				addEvent(s, "clique", "Toque/clique sem alvo 3D detectável")
				return
			end
			if isCharacterPart(target) then return end
			local model = target:FindFirstAncestorOfClass("Model")
			local obj = model or target
			local cd = obj:FindFirstChildWhichIsA("ClickDetector", true) ~= nil
			local pp = obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
