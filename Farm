local function clean(s)
	s = tostring(s)
	if not utf8.len(s) then s = s:gsub("[\128-\255]", "?") end
	return s
end
local function trunc(s, n)
	s = clean(s); n = n or CFG.STR
	if #s <= n then return s end
	local cut = n - 3
	local pos = utf8.offset(s, 0, cut + 1)
	if pos then cut = pos - 1 end
	return s:sub(1, cut) .. "..."
end
local function v3str(v) return string.format("(%.1f, %.1f, %.1f)", v.X, v.Y, v.Z) end
local function pathOf(inst)
	local ok, p = pcall(function() return inst:GetFullName() end)
	return ok and trunc(p, 300) or "não detectado"
end
local function cleanPrim(v)
	local t = typeof(v)
	if t == "number" then
		if v ~= v or v == math.huge or v == -math.huge then return tostring(v) end
		return math.floor(v * 1000 + 0.5) / 1000
	end
	if t == "boolean" then return v end
	if t == "string" then return trunc(v, 120) end
	if t == "Vector3" then return v3str(v) end
	if t == "Instance" then return pathOf(v) end
	return trunc(tostring(v), 120)
end
local function fmtDate(ts) return os.date("%d/%m/%Y %H:%M:%S", ts) end
local function rootPos()
	local c = LocalPlayer.Character
	local h = c and c:FindFirstChild("HumanoidRootPart")
	return h and h.Position or nil
end
local function viewport()
	local cam = Workspace.CurrentCamera
	return cam and cam.ViewportSize or Vector2.new(800, 400)
end
local function posOf(inst, depth)
	depth = depth or 0
	local ok, p = pcall(function()
		if inst:IsA("BasePart") then return inst.Position end
		if inst:IsA("Model") then return inst:GetPivot().Position end
		if inst:IsA("Tool") then
			local h = inst:FindFirstChild("Handle")
			if h and h:IsA("BasePart") then return h.Position end
		end
		if depth < 2 and inst.Parent and (inst:IsA("ProximityPrompt") or inst:IsA("ClickDetector") or inst:IsA("Attachment")) then
			return posOf(inst.Parent, depth + 1)
		end
		return nil
	end)
	if ok then return p end
	return nil
end
local function attrStr(inst)
	local out, n = {}, 0
	pcall(function()
		for k, v in pairs(inst:GetAttributes()) do
			n += 1
			if n > 10 then break end
			out[#out + 1] = clean(k) .. "=" .. tostring(cleanPrim(v))
		end
	end)
	return table.concat(out, "; ")
end
local function executorName()
	if type(identifyexecutor) == "function" then
		local ok, n, v = pcall(identifyexecutor)
		if ok and n then return clean(tostring(n) .. (v and (" " .. tostring(v)) or "")) end
	end
	return "não detectado"
end
local function newMaid()
	local m = { items = {} }
	function m:add(x) self.items[#self.items + 1] = x return x end
	function m:clean()
		for _, x in ipairs(self.items) do
			pcall(function()
				if typeof(x) == "RBXScriptConnection" then x:Disconnect()
				elseif typeof(x) == "Instance" then x:Destroy()
				elseif type(x) == "function" then x() end
			end)
		end
		self.items = {}
	end
	return m
end

----------------------------------------------------------------------
-- [3] ARMAZENAMENTO (persistente quando houver writefile/readfile)
----------------------------------------------------------------------
local Storage = { state = "memory", msg = "" }
local hasFS = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"

local function validateRecord(r)
	if type(r) ~= "table" or type(r.id) ~= "string" or type(r.nome) ~= "string" then return false end
	if not CATS[r.categoria] or type(r.startedAt) ~= "number" or type(r.eventos) ~= "table" then return false end
	for _, e in ipairs(r.eventos) do
		if type(e) ~= "table" or type(e.desc) ~= "string" or type(e.tipo) ~= "string" or type(e.n) ~= "number" or type(e.t) ~= "number" then
			return false
		end
	end
	r.endedAt = type(r.endedAt) == "number" and r.endedAt or r.startedAt
	r.duracao = type(r.duracao) == "number" and r.duracao or 0
	for _, k in ipairs({ "objetos", "diferencas", "inferencias", "limitacoes", "falhas" }) do
		if type(r[k]) ~= "table" then r[k] = {} end
	end
	for _, k in ipairs({ "antes", "depois" }) do
		if type(r[k]) ~= "table" then r[k] = {} end
	end
	if r.completude ~= "completo" and r.completude ~= "parcial" then r.completude = "insuficiente" end
	r.estado = type(r.estado) == "string" and r.estado or "Registro carregado do arquivo"
	r.missao = type(r.missao) == "string" and r.missao or "não registrada"
	r.executor = type(r.executor) == "string" and r.executor or "não registrado"
	r.placeId = r.placeId or 0
	return true
end

function Storage.load()
	if not hasFS then
		Storage.state = "memory"
		Storage.msg = "Executor sem writefile/readfile: registros ficam só na memória e somem ao fechar o jogo."
		return {}
	end
	local okE, exists = pcall(isfile, CFG.FILE)
	if not okE or not exists then
		Storage.state = "pending"
		Storage.msg = "Arquivo disponível; persistência só será confirmada após o primeiro salvamento."
		return {}
	end
	local ok, content = pcall(readfile, CFG.FILE)
	if not ok or type(content) ~= "string" then
		Storage.state = "failed"
		Storage.msg = "Falha ao ler o arquivo de registros; usando memória."
		return {}
	end
	local okD, data = pcall(function() return HttpService:JSONDecode(content) end)
	if not okD or type(data) ~= "table" or type(data.records) ~= "table" then
		Storage.state = "failed"
		Storage.msg = "Arquivo existente inválido (não foi sobrescrito até o próximo salvamento)."
		return {}
	end
	local list, dropped = {}, 0
	for _, r in ipairs(data.records) do
		if validateRecord(r) then list[#list + 1] = r else dropped += 1 end
	end
	Storage.state = "confirmed"
	Storage.msg = string.format("%d registro(s) carregado(s) do arquivo%s.", #list, dropped > 0 and (" (" .. dropped .. " inválido(s) ignorado(s))") or "")
	return list
end

function Storage.save(list)
	if not hasFS then
		Storage.state = "memory"
		Storage.msg = "Sem armazenamento persistente: salvo apenas na memória."
		return false, Storage.msg
	end
	local ok, encoded = pcall(function() return HttpService:JSONEncode({ version = 1, records = list }) end)
	if not ok then
		Storage.state = "failed"; Storage.msg = "Falha ao serializar: " .. trunc(encoded, 80)
		return false, Storage.msg
	end
	local okW, errW = pcall(writefile, CFG.FILE, encoded)
	if not okW then
		Storage.state = "failed"; Storage.msg = "Falha ao gravar arquivo: " .. trunc(errW, 80)
		return false, Storage.msg
	end
	local okR, back = pcall(readfile, CFG.FILE)
	if okR and type(back) == "string" and #back == #encoded then
		Storage.state = "confirmed"; Storage.msg = "Arquivo gravado e verificado (" .. CFG.FILE .. ")."
		return true, Storage.msg
	end
	Storage.state = "failed"; Storage.msg = "Gravação não pôde ser confirmada pela leitura; dados mantidos na memória."
	return false, Storage.msg
end

local Records = { list = Storage.load() }
function Records.persist() return Storage.save(Records.list) end
function Records.find(id)
	for _, r in ipairs(Records.list) do if r.id == id then return r end end
end
function Records.add(rec)
	if #Records.list >= CFG.MAX_RECORDS then
		return false, "Limite de " .. CFG.MAX_RECORDS .. " gravações atingido. Exclua alguma antes de salvar."
	end
	table.insert(Records.list, 1, rec)
	local ok, msg = Records.persist()
	return true, ok and "Salvo e confirmado no arquivo." or ("Salvo na memória. " .. msg)
end
function Records.remove(id)
	for i, r in ipairs(Records.list) do
		if r.id == id then table.remove(Records.list, i) Records.persist() return true end
	end
	return false
end

