			if m == "lixo" then parts[#parts + 1] = "lixo " .. Farm.stats.coletados .. "/" .. Farm.stats.depositados
			elseif m == "grama" then parts[#parts + 1] = "grama " .. Farm.stats.cortadas
			else parts[#parts + 1] = "caixas " .. Farm.stats.caixas end
		end
		say("● " .. Farm.action .. "\n" .. (Farm.note and ("! " .. Farm.note) or table.concat(parts, " • ")), Farm.note and C.amber or C.green)
		startBtn.BackgroundColor3 = C.btn; stopBtn.BackgroundColor3 = C.stopOn
	else
