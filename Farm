		s.maid:add(pg.DescendantAdded:Connect(function(d)
			if s.closed or not (d:IsA("TextLabel") or d:IsA("TextButton")) then return end
			if gui and d:IsDescendantOf(gui) then return end
			local function logText()
				addEvent(s, "ui_texto", "Texto na interface do jogo: '" .. trunc(d.Text, 100) .. "'", d)
			end
			if d.Text:match("%S") then
				logText()
			elseif s.uiWatch < CFG.MAX_UI_WATCH then
				s.uiWatch += 1
				local conn
				conn = d:GetPropertyChangedSignal("Text"):Connect(function()
					if s.closed then return end
					if d.Text:match("%S") then conn:Disconnect() logText() end
				end)
				s.maid:add(conn)
			end
		end))
	end)
	hook("remotes_servidor", function()
		local n = 0
		for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
			if d:IsA("RemoteEvent") then
				n += 1
				if n > CFG.MAX_REMOTES then s.limits.maxRemotes = true break end
				s.maid:add(d.OnClientEvent:Connect(function(...)
					s.remoteHits[d] = (s.remoteHits[d] or 0) + 1
					if s.remoteHits[d] > 3 then s.limits.remoteRepetido = true return end
					local a = table.pack(...)
					local types, prev = {}, nil
					for i = 1, math.min(a.n, 6) do
						types[i] = typeof(a[i])
						if not prev and type(a[i]) == "string" then prev = trunc(a[i], 60) end
					end
					addEvent(s, "remote_servidor", "Servidor->cliente: " .. d.Name .. " (" .. a.n .. " arg.: " .. table.concat(types, ",") .. ")", d,
						{ remote = d.Name, nArgs = a.n, previaTexto = prev or "nenhuma" })
				end))
			end
		end
		s.remotesObservados = n
	end)
	s.thread = task.spawn(function()
		while not s.closed do
			task.wait(0.5)
			if s.closed then break end
			pcall(pollSession, s)
		end
	end)
end

local function diffSnap(a, b)
	local keys, sorted, out = {}, {}, {}
	for k in pairs(a) do keys[k] = true end
	for k in pairs(b) do keys[k] = true end
	for k in pairs(keys) do sorted[#sorted + 1] = k end
	table.sort(sorted)
	for _, k in ipairs(sorted) do
		if tostring(a[k]) ~= tostring(b[k]) then
			out[#out + 1] = k .. ": " .. tostring(a[k] or "—") .. " -> " .. tostring(b[k] or "—")
		end
	end
	return out
end

local function finalize(s)
	local rec = {
		id = s.id, categoria = s.cat, startedAt = s.startedAt, endedAt = os.time(), duracao = os.clock() - s.t0,
		eventos = s.events, objetos = {}, antes = s.antes, depois = s.depois, missao = s.missao,
		executor = executorName(), placeId = game.PlaceId, falhas = s.fails,
	}
	local best, bestScore = nil, 0
	for _, r in ipairs(s.order) do
		local o = s.objects[r]
		o.eventos = s.counts[r] or 0
		rec.objetos[#rec.objetos + 1] = o
		local skip = o.classe == "RemoteEvent" or o.classe == "TextLabel" or o.classe == "TextButton"
		if not skip and (s.score[r] or 0) > bestScore then best, bestScore = r, s.score[r] end
	end
	rec.objetoPrincipal = best
	rec.diferencas = diffSnap(rec.antes, rec.depois)
	local objMap = {}
	for _, o in ipairs(rec.objetos) do objMap[o.ref] = o end
	local function oname(e) local o = e.ref and objMap[e.ref]; return o and (o.nome .. " (" .. o.classe .. ")") or "objeto sem referência" end
	local counts, inter, chg = {}, 0, 0
	for _, e in ipairs(rec.eventos) do
		counts[e.tipo] = (counts[e.tipo] or 0) + 1
		if INTERACTION[e.tipo] then inter += 1 end
		if CHANGE[e.tipo] then chg += 1 end
	end
	-- Inferências (hipóteses, nunca fatos)
	local inf, seen = {}, {}
	local function once(key, text)
		seen[key] = (seen[key] or 0) + 1
		if seen[key] <= 2 then inf[#inf + 1] = "[INFERIDO] " .. text end
	end
	for _, e in ipairs(rec.eventos) do
		local id = string.format("E%03d", e.n)
		if e.tipo == "prompt_acionado" then
			once("pa", id .. ": o jogador acionou um ProximityPrompt (" .. oname(e) .. "). O processamento provavelmente ocorre no servidor; não confirmado.")
		elseif (e.tipo == "personagem_adic" or e.tipo == "mochila_adic") and (rec.categoria == "coleta" or rec.categoria == "pegar_caixa") then
			once("add", id .. ": '" .. oname(e) .. "' passou a ficar com o personagem/mochila — compatível com coleta; não confirmado.")
		elseif (e.tipo == "personagem_rem" or e.tipo == "mochila_rem") and rec.categoria == "deposito" then
			once("rem", id .. ": '" .. oname(e) .. "' deixou o personagem/mochila — compatível com depósito; não confirmado.")
		elseif (e.tipo == "personagem_adic" or e.tipo == "mochila_adic") and rec.categoria == "foice" then
			once("foice", id .. ": '" .. oname(e) .. "' passou a ficar com o personagem/mochila — compatível com compra da foice; não confirmado.")
		elseif e.tipo == "ferramenta" and rec.categoria == "grama" then
			once("tg", id .. ": " .. e.desc .. " — compatível com uso da foice no corte da grama; não confirmado.")
		elseif e.tipo == "objeto_rem" or e.tipo == "removido" then
			once("or", id .. ": " .. oname(e) .. " deixou de existir/foi removido no cliente — pode indicar consumo, depósito, corte ou limpeza feita pelo servidor.")
		elseif e.tipo == "objeto_adic" then
			once("oa", id .. ": " .. oname(e) .. " apareceu perto do personagem — possível item gerado pelo jogo.")
		elseif e.tipo == "leaderstat" then
			once("ls", id .. ": " .. e.desc .. " — correlação temporal com a ação, causalidade não confirmada.")
		elseif e.tipo == "remote_servidor" then
			once("rs", id .. ": o servidor enviou o evento '" .. tostring(e.dados and e.dados.remote or "?") .. "' ao cliente durante a sessão; relação com a ação não confirmada.")
		end
	end
	if #inf == 0 then inf[1] = "[INDISPONÍVEL] Nenhuma hipótese pôde ser formulada com os eventos capturados." end
	rec.inferencias = inf
	-- Limitações
	local lim = {
		"Chamadas cliente->servidor (RemoteEvent/RemoteFunction) NÃO são interceptadas por design; nenhum remote foi descoberto ou disparado.",
		"A lógica executada no servidor não é visível ao cliente; apenas efeitos replicados foram observados.",
		"Objetos fora de " .. CFG.RADIUS .. " studs do personagem não são monitorados para aparecimento/remoção.",
	}
	if inter == 0 then lim[#lim + 1] = "[INDISPONÍVEL] Nenhum evento de interação (ProximityPrompt, clique em alvo 3D ou Tool) foi detectado." end
	if chg == 0 then lim[#lim + 1] = "[INDISPONÍVEL] Nenhuma alteração observável (hierarquia, propriedades, itens, valores) foi detectada; a mudança pode ocorrer só no servidor." end
	if s.flags.clickDetector then lim[#lim + 1] = "ClickDetector detectado no alvo: o disparo MouseClick só ocorre no servidor; o cliente não o observa." end
	if s.flags.semLeaderstats then lim[#lim + 1] = "[INDISPONÍVEL] leaderstats não encontrado para o jogador." end
	if s.flags.semMochila then lim[#lim + 1] = "[INDISPONÍVEL] Backpack não encontrado." end
	lim[#lim + 1] = "RemoteEvents servidor->cliente observados: somente os existentes em ReplicatedStorage (" .. tostring(s.remotesObservados or 0) .. "); só tipos e prévia de texto."
	for k in pairs(s.limits) do lim[#lim + 1] = "Limite atingido: " .. k .. " (dados adicionais descartados para proteger desempenho)." end
	for _, f in ipairs(s.fails) do lim[#lim + 1] = "Falha em módulo de captura: " .. f end
	rec.limitacoes = lim
	-- Completude
	if #rec.eventos <= 2 then rec.completude = "insuficiente"
	elseif inter > 0 and chg > 0 and best then rec.completude = "completo"
	else rec.completude = "parcial" end
	rec.estado = string.format("%d evento(s) capturado(s); %d de interação, %d de alteração.", #rec.eventos, inter, chg)
	return rec
end

function Recorder.start(cat, missao, gui)
	if Recorder.active then
		return nil, "Já existe gravação ativa: " .. CATS[Recorder.active.cat].label .. "."
	end
	if not CATS[cat] then return nil, "Categoria inválida." end
	local s = {
		id = os.date("%Y%m%d-%H%M%S") .. "-" .. HttpService:GenerateGUID(false):sub(1, 4), cat = cat, missao = missao,
		startedAt = os.time(), t0 = os.clock(), events = {}, objects = {}, order = {}, refs = {}, counts = {}, score = {},
		typeCount = {}, limits = {}, flags = {}, fails = {}, objCount = 0, trackedSet = {}, trackedCount = 0,
		objPos = {}, objMoves = {}, uiWatch = 0, closed = false, maid = newMaid(), remoteHits = {},
	}
	Recorder.active = s
	s.antes = snapshot()
	local ok, err = pcall(setupSession, s, gui)
	if not ok then s.fails[#s.fails + 1] = "setup: " .. trunc(err, 120) end
	addEvent(s, "sessao", "Gravação iniciada (" .. CATS[cat].label .. ")")
	return s
end

local function closeSession(s)
	s.closed = true
	if Recorder.active == s then Recorder.active = nil end
	s.maid:clean()
	if s.thread then pcall(task.cancel, s.thread) end
	s.refs, s.trackedSet, s.objPos = {}, {}, {}
end

function Recorder.stop()
	local s = Recorder.active
	if not s then return nil, "Nenhuma gravação ativa." end
	addEvent(s, "sessao", "Gravação encerrada pelo usuário")
	closeSession(s)
	s.depois = snapshot()
	local ok, rec = pcall(finalize, s)
	if not ok then return nil, "Falha ao gerar relatório: " .. trunc(rec, 100) end
	return rec
end

function Recorder.abort()
	if Recorder.active then closeSession(Recorder.active) end
end

----------------------------------------------------------------------
-- [4a] DETECTOR DE ÁREA DE ENTREGA (um único toque)
-- Lê o que está sob/ao redor do personagem e registra posição, tamanho e
-- orientação exatos das peças candidatas. Não move o personagem.
----------------------------------------------------------------------
local ZONE_WORDS = { "entreg", "deliver", "dropoff", "drop", "zona", "zone", "area", "área", "marc", "caixa", "box", "objetivo", "target", "finish", "destin" }
local function p2(v) return string.format("(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z) end

local function detectDeliveryZone(missao)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil, "Personagem não encontrado." end
	local pos = hrp.Position
	local feet = pos - Vector3.new(0, 3, 0)
	local ev = {}
	local function addEv(tipo, desc, ref, dados)
		local d
		if dados then d = {}; for k, v in pairs(dados) do d[clean(k)] = cleanPrim(v) end end
		ev[#ev + 1] = { n = #ev + 1, t = 0, tipo = tipo, desc = trunc(desc, CFG.STR), ref = ref, dados = d }
	end
	local antes = snapshot()
	addEv("sessao", "Detecção de área de entrega iniciada (toque único)", nil, { posicaoJogador = p2(pos) })

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	local okP, parts = pcall(function() return Workspace:GetPartBoundsInRadius(pos, 14, params) end)
	if not okP or type(parts) ~= "table" then parts = {} end
	local rparams = RaycastParams.new()
	rparams.FilterType = Enum.RaycastFilterType.Exclude
	rparams.FilterDescendantsInstances = { char }
	local okR, hit = pcall(function() return Workspace:Raycast(pos, Vector3.new(0, -25, 0), rparams) end)
	local floorPart = okR and hit and hit.Instance or nil

	local cand, seen = {}, {}
	local function consider(part, isFloor)
		if seen[part] or not part:IsA("BasePart") then return end
		seen[part] = true
		local size = part.Size
		local touch = false
		pcall(function() touch = part:FindFirstChildOfClass("TouchTransmitter") ~= nil end)
		if math.max(size.X, size.Y, size.Z) > 250 and not touch and not isFloor then return end
		local rel = part.CFrame:PointToObjectSpace(feet)
		local inside = math.abs(rel.X) <= size.X / 2 + 0.05 and math.abs(rel.Z) <= size.Z / 2 + 0.05 and math.abs(rel.Y) <= size.Y / 2 + 5
		local lname = (part.Name .. " " .. (part.Parent and part.Parent.Name or "")):lower()
		local sc, why, nameHit = 0, {}, false
		for _, w in ipairs(ZONE_WORDS) do
			if lname:find(w, 1, true) then sc += 3; nameHit = true; why[#why + 1] = "nome~" .. w; break end
		end
		if touch then sc += 4; why[#why + 1] = "TouchInterest" end
		if not part.CanCollide then sc += 2; why[#why + 1] = "CanCollide=false" end
		if part.Transparency >= 0.3 then sc += 1; why[#why + 1] = "semi-transparente" end
		if math.min(size.X, size.Y, size.Z) <= 1.5 then sc += 1; why[#why + 1] = "peça fina" end
		local at = attrStr(part)
		if at ~= "" then sc += 1; why[#why + 1] = "tem atributos" end
		if inside then sc += 4; why[#why + 1] = "jogador dentro" end
		if isFloor then why[#why + 1] = "peça sob os pés" end
		if sc == 0 and not isFloor then return end
		local dist = (part.Position - pos).Magnitude
		cand[#cand + 1] = { part = part, score = sc, why = why, inside = inside, touch = touch, nameHit = nameHit, floor = isFloor, dist = dist, attrs = at }
	end
	if floorPart then consider(floorPart, true) end
	for _, p in ipairs(parts) do consider(p, p == floorPart) end
	table.sort(cand, function(a, b)
		if a.score ~= b.score then return a.score > b.score end
		return a.dist < b.dist
	end)
	while #cand > 8 do table.remove(cand) end

	local objetos, best = {}, nil
	for i, c in ipairs(cand) do
		local part = c.part
		local ref = string.format("OBJ-%03d", i)
		local extra = string.format("Centro=%s; Tamanho=%s; Orientacao=%s; CanCollide=%s; CanTouch=%s; TouchInterest=%s; Transparencia=%s; Pontos=%d; Motivos=%s",
			p2(part.Position), p2(part.Size), p2(part.Orientation), tostring(part.CanCollide), tostring(part.CanTouch), tostring(c.touch),
			tostring(cleanPrim(part.Transparency)), c.score, table.concat(c.why, ","))
		objetos[#objetos + 1] = {
			ref = ref, nome = clean(part.Name), classe = part.ClassName, caminho = pathOf(part), posicao = v3str(part.Position),
			distancia = string.format("%.1f", c.dist), atributos = (c.attrs ~= "" and (c.attrs .. "; ") or "") .. extra, eventos = 1,
		}
		c.ref = ref
		if not best and c.inside and (c.touch or c.nameHit or not part.CanCollide) then best = c end
	end
	if not best and cand[1] then best = cand[1] end

	addEv("estado", "Jogador em " .. p2(pos) .. " (pés ~ " .. p2(feet) .. ")", nil)
	addEv("estado", floorPart and ("Peça sob os pés: " .. clean(floorPart.Name) .. " (" .. floorPart.ClassName .. ")") or "Nenhuma peça sob os pés (raycast)", nil)
	for _, c in ipairs(cand) do
		local part = c.part
		addEv("area_candidata", string.format("Candidata %s: %s (%s) | pontos %d | %s", c.ref, clean(part.Name), part.ClassName, c.score, table.concat(c.why, ", ")), c.ref, {
			centro = p2(part.Position), tamanho = p2(part.Size), orientacao = p2(part.Orientation), dentro = c.inside,
			touchInterest = c.touch, canCollide = part.CanCollide, canTouch = part.CanTouch, distancia = string.format("%.1f", c.dist),
		})
	end
	if best then
		addEv("resultado", string.format("Melhor candidata: %s em %s, tamanho %s, jogador %s", best.ref, p2(best.part.Position), p2(best.part.Size), best.inside and "DENTRO" or "FORA"), best.ref)
	else
		addEv("resultado", "Nenhuma peça candidata encontrada num raio de 14 studs.", nil)
	end
	addEv("sessao", "Detecção encerrada")

	local inf = {}
	if best then
		inf[#inf + 1] = "[INFERIDO] " .. best.ref .. " (" .. clean(best.part.Name) .. ") é a candidata mais provável da área de entrega (" .. table.concat(best.why, ", ") .. "); não confirmado."
		inf[#inf + 1] = "[INFERIDO] Para posicionar o personagem na área, o alvo seria o centro " .. p2(best.part.Position) .. " (altura dos pés = topo da peça); não confirmado."
		if not best.inside then inf[#inf + 1] = "[INFERIDO] O jogador estava FORA da melhor candidata: repita o toque em pé no meio da área marcada." end
	else
		inf[1] = "[INDISPONÍVEL] Nenhuma hipótese pôde ser formulada: nenhuma peça candidata perto do jogador."
	end
	local completude = "insuficiente"
	if best then
		completude = (best.inside and (best.touch or best.nameHit or not best.part.CanCollide)) and "completo" or "parcial"
	end
	local now = os.time()
	local rec = {
		id = os.date("%Y%m%d-%H%M%S") .. "-" .. HttpService:GenerateGUID(false):sub(1, 4), categoria = "entregar_caixa",
