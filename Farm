emptyLabel.Name = "Empty"
local compColor = { completo = C.green, parcial = C.amber, insuficiente = C.red }
local compText = { completo = "Dados completos", parcial = "Dados parciais", insuficiente = "Dados insuficientes" }

renderCards = function()
	for _, c in ipairs(pageDiag:GetChildren()) do
		if c:IsA("GuiObject") and c.Name ~= "Empty" then c:Destroy() end
	end
	emptyLabel.Visible = #Records.list == 0
	for _, rec in ipairs(Records.list) do
		local card = mk("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.card, BorderSizePixel = 0 }, pageDiag)
		corner(card, 10); stroke(card); pad(card, 9, 9); vlist(card, 4)
		label(card, rec.nome, 12, C.text, true)
		label(card, CATS[rec.categoria].label .. " • " .. os.date("%d/%m %H:%M", rec.startedAt), 10, C.muted)
		label(card, #rec.eventos .. " evento(s) • " .. rec.estado, 9, C.muted)
		label(card, "● " .. compText[rec.completude], 10, compColor[rec.completude], true)
		local row = mk("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1 }, card)
		mk("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, row)
		button(row, "Diagnóstico", UDim2.new(0.4, -4, 0, 28), function() openDetail(rec) end)
		button(row, "Copiar", UDim2.new(0.3, -4, 0, 28), function()
			if copyText(fullReport(rec)) then toast("Relatório copiado.") else toast("Este executor não oferece setclipboard.") end
		end)
		button(row, "Excluir", UDim2.new(0.3, -4, 0, 28), function()
			showModal({
				title = "Excluir gravação?", text = "'" .. rec.nome .. "' será removida. Outras gravações não serão afetadas.", confirm = "Excluir", danger = true,
				onConfirm = function()
					Records.remove(rec.id)
					if detailRec == rec then detail.Visible = false; detailRec = nil end
					renderCards()
					refreshRecording()
					toast("Gravação excluída.")
				end,
			})
		end, Color3.fromRGB(58, 34, 38))
	end
end

