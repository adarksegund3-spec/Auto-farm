end

----------------------------------------------------------------------
-- [4b] AUTO FARM (lixo / grama / ambos) — teleporte + instant interact nativo
-- Caminhos vistos no diagnóstico:
-- Workspace.Map.Sistemas.Jobs["Recolher Lixo"].Lixos / .Lixeiras
-- Workspace.Map.Sistemas.Jobs["Cortar Grama"].Gramas (prompt "Cortar [Requer Foice]", atributo Ativo)
-- Alvo: ~0.5s por ação.
----------------------------------------------------------------------
local Farm = { running = false, kind = nil, t0 = 0, action = "parado", stats = { coletados = 0, depositados = 0, cortadas = 0 }, black = {} }
do -- escopo do farm (reduz locals do chunk principal)
local farmGen = 0
local originalHold = {}
local originalLOS = {}
local farmMaid = newMaid()

local function jobFolder(name)
	local cur = Workspace
	for _, n in ipairs({ "Map", "Sistemas", "Jobs", name }) do
		cur = cur and cur:FindFirstChild(n)
	end
	return cur
end
local function farmRoot()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function findTool(name)
	local c = LocalPlayer.Character
	local t = c and c:FindFirstChild(name)
	if t and t:IsA("Tool") then return t, true end
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
	t = bp and bp:FindFirstChild(name)
	if t and t:IsA("Tool") then return t, false end
	return nil, false
end
local function hasTrashTool() return findTool("Lixo") ~= nil end
local function teleportTo(pos)
	local hrp = farmRoot()
	if not hrp or not pos then return false end
	return pcall(function()
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
	end)
end

-- INSTANT INTERACT: HoldDuration = 0 e sem checagem de linha de visão (valores originais restaurados ao parar)
local function makeInstant(p)
	if typeof(p) ~= "Instance" or not p:IsA("ProximityPrompt") then return end
	pcall(function()
		if originalHold[p] == nil then originalHold[p] = p.HoldDuration end
		if originalLOS[p] == nil then originalLOS[p] = p.RequiresLineOfSight end
		p.HoldDuration = 0
		p.RequiresLineOfSight = false
	end)
end
local function enableInstant(job)
	for _, d in ipairs(job:GetDescendants()) do makeInstant(d) end
	farmMaid:add(job.DescendantAdded:Connect(makeInstant))
end
-- Aciona sem bloquear o loop (fireproximityprompt de alguns executores yielda)
local function triggerPrompt(p)
	makeInstant(p)
	task.spawn(function()
		if type(fireproximityprompt) == "function" then pcall(fireproximityprompt, p) end
	end)
end
local function triggerFallback(p)
	task.spawn(function()
		pcall(function()
			p:InputHoldBegin()
			task.wait()
			p:InputHoldEnd()
		end)
	end)
end
local function waitFor(cond, timeout, alive)
	local t0 = os.clock()
	while alive() and os.clock() - t0 < timeout do
		if cond() then return true end
		task.wait(0.03)
	end
	return cond()
end
local function collectPrompts(job, folderName, needActive)
	local out, now = {}, os.clock()
	local folder = job:FindFirstChild(folderName)
	if not folder then return out end
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled then
			local part, bl = d.Parent, Farm.black[d]
			if not (bl and bl > now) and part and part:IsA("BasePart") then
				if not needActive or (part:GetAttribute("Ativo") ~= false and part.Transparency < 1) then
					out[#out + 1] = d
				end
			end
		end
	end
	return out
end
local function nearest(list, from)
	local best, bd
	for _, p in ipairs(list) do
		local pos = posOf(p)
		if pos then
			local d = (pos - from).Magnitude
			if not bd or d < bd then best, bd = p, d end
		end
	end
	return best
end
function Farm.restoreHold()
	for p, v in pairs(originalHold) do pcall(function() p.HoldDuration = v end) end
	for p, v in pairs(originalLOS) do pcall(function() p.RequiresLineOfSight = v end) end
	originalHold, originalLOS = {}, {}
end
function Farm.stop()
	farmGen += 1
	Farm.running = false
	Farm.action = "parado"
	farmMaid:clean()
	Farm.restoreHold()
end

local function trashStep(job, hrp, alive)
	if hasTrashTool() then
		local bin = nearest(collectPrompts(job, "Lixeiras", false), hrp.Position)
		if not bin then Farm.action = "sem lixeira disponível"; task.wait(0.5) return end
		Farm.action = "depositando"
		teleportTo(posOf(bin))
		task.wait(0.08)
		triggerPrompt(bin)
		local done = waitFor(function() return not hasTrashTool() end, 0.25, alive)
		if not done and alive() then
			triggerFallback(bin)
			done = waitFor(function() return not hasTrashTool() end, 0.3, alive)
		end
		if done then Farm.stats.depositados += 1 else Farm.black[bin] = os.clock() + 2 end
	else
		local pr = nearest(collectPrompts(job, "Lixos", true), hrp.Position)
		if not pr then Farm.action = "procurando lixo ativo"; task.wait(0.5) return end
		Farm.action = "coletando"
		teleportTo(posOf(pr))
		task.wait(0.08)
		triggerPrompt(pr)
		local done = waitFor(hasTrashTool, 0.25, alive)
		if not done and alive() then
			triggerFallback(pr)
			done = waitFor(hasTrashTool, 0.3, alive)
		end
		if done then Farm.stats.coletados += 1 else Farm.black[pr] = os.clock() + 5 end
	end
end

-- retorna false quando não há foice (para o modo "ambos" cair no lixo)
local function grassStep(job, hrp, alive)
	local tool, equipped = findTool("Foice")
	if not tool then
		Farm.action = "sem foice (compre em 'Comprar foice')"
		return false
	end
	if not equipped then
		Farm.action = "equipando foice"
		local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if hum then pcall(function() hum:EquipTool(tool) end) end
		task.wait(0.15)
	end
	local pr = nearest(collectPrompts(job, "Gramas", true), hrp.Position)
	if not pr then Farm.action = "procurando grama ativa"; task.wait(0.5) return true end
	Farm.action = "cortando grama"
	teleportTo(posOf(pr))
	task.wait(0.08)
	triggerPrompt(pr)
	local part = pr.Parent
	local function cut()
		return not pr:IsDescendantOf(Workspace) or part:GetAttribute("Ativo") == false or part.Transparency >= 1
	end
	local done = waitFor(cut, 0.3, alive)
	if not done and alive() then
		triggerFallback(pr)
		done = waitFor(cut, 0.3, alive)
	end
	if done then Farm.stats.cortadas += 1 else Farm.black[pr] = os.clock() + 5 end
	return true
end

local function farmStep(gen)
	local function alive() return Farm.running and farmGen == gen end
	local hrp = farmRoot()
	if not hrp then Farm.action = "aguardando personagem"; task.wait(0.5) return end
	local kind = Farm.kind
	local jl = (kind == "lixo" or kind == "ambos") and jobFolder("Recolher Lixo") or nil
	local jg = (kind == "grama" or kind == "ambos") and jobFolder("Cortar Grama") or nil
	if (kind == "lixo" or kind == "ambos") and not jl then Farm.action = "trabalho de lixo não encontrado"; task.wait(1) return end
	if (kind == "grama" or kind == "ambos") and not jg then Farm.action = "trabalho de grama não encontrado"; task.wait(1) return end
	if kind == "lixo" then
		trashStep(jl, hrp, alive)
	elseif kind == "grama" then
		if grassStep(jg, hrp, alive) == false then task.wait(1) end
	else
		-- ambos: alterna a cada 30s; se estiver carregando lixo, termina o depósito primeiro
		local grassPhase = math.floor((os.clock() - Farm.t0) / 30) % 2 == 1
		if hasTrashTool() or not grassPhase then
			trashStep(jl, hrp, alive)
		elseif grassStep(jg, hrp, alive) == false then
			trashStep(jl, hrp, alive)
		end
	end
end
function Farm.start(kind)
	if Farm.running then return false, "Farm já está ativo." end
	if Recorder.active then return false, "Finalize a gravação antes de iniciar o farm." end
	kind = kind or "lixo"
	local jl, jg = jobFolder("Recolher Lixo"), jobFolder("Cortar Grama")
	if (kind == "lixo" or kind == "ambos") and not jl then return false, "Pasta Jobs.Recolher Lixo não encontrada." end
	if (kind == "grama" or kind == "ambos") and not jg then return false, "Pasta Jobs.Cortar Grama não encontrada." end
	if kind == "grama" and not findTool("Foice") then return false, "Você não tem a Foice. Compre antes (o farm não gasta dinheiro sozinho)." end
	farmGen += 1
	local gen = farmGen
	Farm.running = true
	Farm.kind = kind
	Farm.t0 = os.clock()
	Farm.stats = { coletados = 0, depositados = 0, cortadas = 0 }
	Farm.black = {}
	Farm.action = "iniciando"
	farmMaid:clean()
	if jl and (kind == "lixo" or kind == "ambos") then enableInstant(jl) end
	if jg and (kind == "grama" or kind == "ambos") then enableInstant(jg) end
	task.spawn(function()
		while Farm.running and farmGen == gen do
			local ok, err = pcall(farmStep, gen)
			if not ok then Farm.action = "erro: " .. trunc(err, 60); task.wait(1) end
			task.wait()
		end
	end)
	return true
end

end -- fim do escopo do farm

