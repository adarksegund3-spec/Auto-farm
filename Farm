	end)
	hook("workspace", function()
		local function relevant(d)
			return d:IsA("Model") or d:IsA("Tool") or d:IsA("BasePart") or d:IsA("ProximityPrompt") or d:IsA("ClickDetector")
		end
		s.maid:add(Workspace.DescendantAdded:Connect(function(d)
			if s.closed or not relevant(d) then return end
			local rp = rootPos()
			if not rp or insideRecorded(s, d) or isCharacterPart(d) then return end
			local p = posOf(d)
			if not p or (p - rp).Magnitude > CFG.RADIUS then return end
			addEvent(s, "objeto_adic", string.format("Apareceu a %.0f studs: %s (%s)", (p - rp).Magnitude, d.Name, d.ClassName), d)
			if not d:IsA("BasePart") or not (d.Parent and d.Parent:IsA("Model")) then track(s, d) end
		end))
		s.maid:add(Workspace.DescendantRemoving:Connect(function(d)
			if s.closed or s.trackedSet[d] or not relevant(d) then return end
			local rp = rootPos()
			if not rp or insideRecorded(s, d) or isCharacterPart(d) then return end
			local p = posOf(d)
			if not p or (p - rp).Magnitude > CFG.RADIUS then return end
			addEvent(s, "objeto_rem", string.format("Removido a %.0f studs: %s (%s)", (p - rp).Magnitude, d.Name, d.ClassName), d)
