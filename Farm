	bg = Color3.fromRGB(13, 13, 16), panel = Color3.fromRGB(20, 21, 26), card = Color3.fromRGB(27, 28, 35),
	stroke = Color3.fromRGB(46, 48, 58), text = Color3.fromRGB(232, 235, 242), muted = Color3.fromRGB(142, 147, 160),
	accent = Color3.fromRGB(128, 192, 255), red = Color3.fromRGB(232, 88, 88), green = Color3.fromRGB(98, 208, 140),
	amber = Color3.fromRGB(238, 188, 92), btn = Color3.fromRGB(38, 40, 50),
	startOn = Color3.fromRGB(34, 84, 56), stopOn = Color3.fromRGB(110, 44, 48),
}

----------------------------------------------------------------------
-- UTILITÁRIOS
----------------------------------------------------------------------
local function short(s, n) s = tostring(s); n = n or 60; return #s > n and (s:sub(1, n - 3) .. "...") or s end
local function viewport()
	local cam = Workspace.CurrentCamera
	return cam and cam.ViewportSize or Vector2.new(800, 400)
end
local function posOf(inst, depth)
	depth = depth or 0
	local ok, p = pcall(function()
		if inst:IsA("BasePart") then return inst.Position end
		if inst:IsA("Model") then return inst:GetPivot().Position end
		if depth < 2 and inst.Parent and inst:IsA("ProximityPrompt") then return posOf(inst.Parent, depth + 1) end
		return nil
	end)
	if ok then return p end
	return nil
end
local function newMaid()
	local m = { items = {} }
	function m:add(x) self.items[#self.items + 1] = x return x end
	function m:clean()
		for _, x in ipairs(self.items) do
			pcall(function()
				if typeof(x) == "RBXScriptConnection" then x:Disconnect()
				elseif typeof(x) == "Instance" then x:Destroy()
				elseif type(x) == "function" then x() end
			end)
		end
		self.items = {}
	end
	return m
end

----------------------------------------------------------------------
-- FARM
-- Workspace.Map.Sistemas.Jobs["Recolher Lixo"].Lixos / .Lixeiras
-- Workspace.Map.Sistemas.Jobs["Cortar Grama"].Foice (loja) / .Gramas (atributo Ativo)
-- Workspace.Map.Sistemas.Jobs.Caixas (prompt "Pegar") -> Tool "Caixa" -> entrega na área marcada
----------------------------------------------------------------------
local Farm = {
	running = false, mods = {}, t0 = 0, action = "parado", black = {},
	stats = { coletados = 0, depositados = 0, cortadas = 0, caixas = 0 },
}
do
local farmGen = 0
local originalHold, originalLOS = {}, {}
local farmMaid = newMaid()
local noBuyUntil = 0

local function jobFolder(key)
	local cur = Workspace
	for _, n in ipairs({ "Map", "Sistemas", "Jobs", JOBS[key] }) do
		cur = cur and cur:FindFirstChild(n)
	end
	return cur
end
local function farmRoot()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function findTool(name)
	local c = LocalPlayer.Character
	local t = c and c:FindFirstChild(name)
	if t and t:IsA("Tool") then return t, true end
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
	t = bp and bp:FindFirstChild(name)
	if t and t:IsA("Tool") then return t, false end
	return nil, false
end
local function moneyStr()
	local ls = LocalPlayer:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild("Dinheiro")
	return v and tostring(v.Value) or ""
end
local function teleportTo(pos, lift)
	local hrp = farmRoot()
	if not hrp or not pos then return false end
	return pcall(function()
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(pos + Vector3.new(0, lift or 3, 0))
	end)
end

-- INSTANT INTERACT: HoldDuration = 0 e sem linha de visão (restaurado ao parar)
local function makeInstant(p)
	if typeof(p) ~= "Instance" or not p:IsA("ProximityPrompt") then return end
	pcall(function()
		if originalHold[p] == nil then originalHold[p] = p.HoldDuration end
		if originalLOS[p] == nil then originalLOS[p] = p.RequiresLineOfSight end
		p.HoldDuration = 0
		p.RequiresLineOfSight = false
	end)
end
local function enableInstant(job)
	for _, d in ipairs(job:GetDescendants()) do makeInstant(d) end
	farmMaid:add(job.DescendantAdded:Connect(makeInstant))
end
local function triggerPrompt(p)
	makeInstant(p)
	task.spawn(function()
		if type(fireproximityprompt) == "function" then pcall(fireproximityprompt, p) end
	end)
end
local function triggerFallback(p)
	task.spawn(function()
		pcall(function() p:InputHoldBegin(); task.wait(); p:InputHoldEnd() end)
	end)
end
local function waitFor(cond, timeout, alive)
	local t0 = os.clock()
	while alive() and os.clock() - t0 < timeout do
		if cond() then return true end
		task.wait(0.03)
	end
	return cond()
end
local function collectPrompts(container, needActive)
	local out, now = {}, os.clock()
	if not container then return out end
	for _, d in ipairs(container:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled then
			local part, bl = d.Parent, Farm.black[d]
			if not (bl and bl > now) and part and part:IsA("BasePart") then
				if not needActive or (part:GetAttribute("Ativo") ~= false and part.Transparency < 1) then
					out[#out + 1] = d
				end
			end
		end
	end
	return out
end
local function nearest(list, from)
	local best, bd
	for _, p in ipairs(list) do
		local pos = posOf(p)
		if pos then
			local d = (pos - from).Magnitude
			if not bd or d < bd then best, bd = p, d end
		end
	end
	return best
end
-- teleporta, aciona e confirma (≈0.5s); true se confirmou
local function interact(p, doneFn, alive)
	teleportTo(posOf(p))
	task.wait(0.08)
	triggerPrompt(p)
	local done = waitFor(doneFn, 0.25, alive)
	if not done and alive() then
		triggerFallback(p)
		done = waitFor(doneFn, 0.3, alive)
	end
	return done
end

function Farm.restoreHold()
	for p, v in pairs(originalHold) do pcall(function() p.HoldDuration = v end) end
	for p, v in pairs(originalLOS) do pcall(function() p.RequiresLineOfSight = v end) end
	originalHold, originalLOS = {}, {}
end
function Farm.stop()
	farmGen += 1
	Farm.running = false
	Farm.action = "parado"
	farmMaid:clean()
	Farm.restoreHold()
end

-- LIXO
local function trashStep(job, hrp, alive)
	if findTool("Lixo") then
		local bin = nearest(collectPrompts(job:FindFirstChild("Lixeiras"), false), hrp.Position)
		if not bin then Farm.action = "sem lixeira disponível"; task.wait(0.5) return true end
		Farm.action = "guardando lixo"
		if interact(bin, function() return findTool("Lixo") == nil end, alive) then
			Farm.stats.depositados += 1
		else
			Farm.black[bin] = os.clock() + 2
		end
	else
		local pr = nearest(collectPrompts(job:FindFirstChild("Lixos"), true), hrp.Position)
		if not pr then Farm.action = "procurando lixo ativo"; task.wait(0.5) return true end
		Farm.action = "pegando lixo"
		if interact(pr, function() return findTool("Lixo") ~= nil end, alive) then
			Farm.stats.coletados += 1
		else
			Farm.black[pr] = os.clock() + 5
		end
	end
	return true
end

-- GRAMA (compra a foice se não tiver)
local function ensureFoice(job, alive)
	if findTool("Foice") then return true end
	if os.clock() < noBuyUntil then Farm.action = "sem foice (compra falhou)"; return false end
	local shop = job:FindFirstChild("Foice")
	local pr = shop and shop:FindFirstChildWhichIsA("ProximityPrompt", true)
	if not pr then Farm.action = "loja da foice não encontrada"; noBuyUntil = os.clock() + 10; return false end
	Farm.action = "comprando foice"
	local done = interact(pr, function() return findTool("Foice") ~= nil end, alive)
	if not done then
		task.wait(0.3)
		done = findTool("Foice") ~= nil
	end
	if not done and alive() then
		noBuyUntil = os.clock() + 20
		Farm.action = "foice não comprada (dinheiro?)"
		return false
	end
	return done
end
local function grassStep(job, hrp, alive)
	if not ensureFoice(job, alive) then return false end
	local tool, equipped = findTool("Foice")
	if tool and not equipped then
		Farm.action = "equipando foice"
		local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if hum then pcall(function() hum:EquipTool(tool) end) end
		task.wait(0.15)
	end
	local pr = nearest(collectPrompts(job:FindFirstChild("Gramas"), true), hrp.Position)
	if not pr then Farm.action = "procurando grama ativa"; task.wait(0.5) return true end
	Farm.action = "cortando grama"
	local part = pr.Parent
	local function cut()
		return not pr:IsDescendantOf(Workspace) or part:GetAttribute("Ativo") == false or part.Transparency >= 1
	end
	if interact(pr, cut, alive) then Farm.stats.cortadas += 1 else Farm.black[pr] = os.clock() + 5 end
	return true
end

-- CAIXA (pega no prompt e entrega na área marcada)
local function deliverBox(alive)
	local m0 = moneyStr()
	for _, off in ipairs(CFG.DELIVERY_OFFSETS) do
		if not alive() then return end
		Farm.action = "entregando caixa"
		teleportTo(CFG.DELIVERY + off, 0)
		if waitFor(function() return findTool("Caixa") == nil or moneyStr() ~= m0 end, 0.5, alive) then
			Farm.stats.caixas += 1
			return
		end
	end
	Farm.action = "entrega não confirmada"
	task.wait(1)
end
local function boxStep(job, hrp, alive)
	if findTool("Caixa") then
		deliverBox(alive)
		return true
	end
	local pr = nearest(collectPrompts(job, false), hrp.Position)
	if not pr then Farm.action = "aguardando caixa"; task.wait(0.5) return true end
	Farm.action = "pegando caixa"
	if not interact(pr, function() return findTool("Caixa") ~= nil end, alive) then
		Farm.black[pr] = os.clock() + 2
	end
	return true
end

local function has(mod)
	for _, m in ipairs(Farm.mods) do if m == mod then return true end end
	return false
end
local function runMod(mod, hrp, alive)
	local job = jobFolder(mod)
	if not job then Farm.action = "trabalho '" .. JOBS[mod] .. "' não encontrado"; return false end
	if mod == "lixo" then return trashStep(job, hrp, alive) end
	if mod == "grama" then return grassStep(job, hrp, alive) end
	return boxStep(job, hrp, alive)
end
local function farmStep(gen)
	local function alive() return Farm.running and farmGen == gen end
	local hrp = farmRoot()
	if not hrp then Farm.action = "aguardando personagem"; task.wait(0.5) return end
	local mods = Farm.mods
	local mod
	if has("lixo") and findTool("Lixo") then mod = "lixo"
	elseif has("caixa") and findTool("Caixa") then mod = "caixa"
	elseif #mods == 1 then mod = mods[1]
	else mod = mods[math.floor((os.clock() - Farm.t0) / CFG.SLICE) % #mods + 1] end
	if runMod(mod, hrp, alive) == false then
		for _, o in ipairs(mods) do
			if o ~= mod and runMod(o, hrp, alive) ~= false then return end
		end
		task.wait(1)
	end
end
function Farm.start(mods)
	if Farm.running then return false, "Farm já está ativo." end
	for _, m in ipairs(mods) do
		if not jobFolder(m) then return false, "Trabalho '" .. JOBS[m] .. "' não encontrado no mapa." end
	end
	farmGen += 1
	local gen = farmGen
	Farm.running = true
	Farm.mods = mods
	Farm.t0 = os.clock()
	Farm.stats = { coletados = 0, depositados = 0, cortadas = 0, caixas = 0 }
	Farm.black = {}
	Farm.action = "iniciando"
	noBuyUntil = 0
	farmMaid:clean()
	for _, m in ipairs(mods) do enableInstant(jobFolder(m)) end
	task.spawn(function()
		while Farm.running and farmGen == gen do
			local ok, err = pcall(farmStep, gen)
			if not ok then Farm.action = "erro: " .. short(err, 50); task.wait(1) end
			task.wait()
		end
	end)
	return true
end
end -- fim do escopo do farm

