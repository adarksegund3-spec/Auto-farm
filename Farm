--[[ Auto Farm • Drip Menu — by Angel — v3 (menu único, sem abas) — com carregador seguro
     Se algo falhar, o erro aparece numa caixa vermelha na tela E é copiado para a área de transferência.
     Os números de linha do erro se referem ao código interno (linha 1 = primeira linha após o início do bloco SRC). ]]

local function showError(msg)
	msg = tostring(msg)
	pcall(function() warn("[DripMenu] " .. msg) end)
	pcall(function() if setclipboard then setclipboard(msg) end end)
	pcall(function()
		local parent = (type(gethui) == "function" and gethui()) or game:GetService("CoreGui")
		local g = Instance.new("ScreenGui")
		g.Name = "DripMenuError"; g.ResetOnSpawn = false; g.IgnoreGuiInset = true; g.Parent = parent
		local t = Instance.new("TextBox")
		t.Size = UDim2.new(1, -20, 0, 190); t.Position = UDim2.new(0, 10, 0, 40)
		t.BackgroundColor3 = Color3.fromRGB(40, 0, 0); t.TextColor3 = Color3.new(1, 1, 1)
		t.TextWrapped = true; t.TextSize = 13; t.ClearTextOnFocus = false
		t.TextXAlignment = Enum.TextXAlignment.Left; t.TextYAlignment = Enum.TextYAlignment.Top
		t.Text = "DRIP MENU - ERRO (copiado p/ área de transferência):\n" .. msg
		t.Parent = g
	end)
end

local SRC = [==[
--[[
	Auto Farm • Drip Menu — by Angel
	Missões: lixo (pegar/guardar), grama (compra foice + corta), caixa (pega/entrega),
	"Ambos" (lixo + grama) e "Todos" (lixo + grama + caixa).
	Teleporte + instant interact nativo (HoldDuration = 0 só localmente; restaurado ao parar).
	Por sua conta e risco: pode violar as regras do jogo/Roblox.
]]

local ENV = (getgenv and getgenv()) or _G
if ENV.__AutoFarmDripMenu and type(ENV.__AutoFarmDripMenu.destroy) == "function" then
	pcall(ENV.__AutoFarmDripMenu.destroy)
end

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then return end

----------------------------------------------------------------------
-- CONFIG
----------------------------------------------------------------------
local CFG = {
	SLICE = 30, -- segundos por módulo no modo "Ambos"/"Todos" (termina o item carregado antes de trocar)
	-- Posição (HumanoidRootPart) registrada DENTRO da área de entrega da caixa. Ajuste aqui se precisar.
	DELIVERY = Vector3.new(440.63, 3.85, -223.15),
	DELIVERY_OFFSETS = { Vector3.new(0, 0, 0), Vector3.new(2, 0, 0), Vector3.new(-2, 0, 0), Vector3.new(0, 0, 2), Vector3.new(0, 0, -2) },
}
local JOBS = { lixo = "Recolher Lixo", grama = "Cortar Grama", caixa = "Caixas" }
local MISSIONS = {
	{ label = "Recolher lixo", mods = { "lixo" } },
	{ label = "Cortar grama", mods = { "grama" } },
	{ label = "Ambos (grama e lixo)", mods = { "lixo", "grama" } },
	{ label = "Entregar Caixa", mods = { "caixa" } },
	{ label = "Todos", mods = { "lixo", "grama", "caixa" } },
}
