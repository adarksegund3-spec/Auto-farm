	return b
end
local startBtn = actionButton("Iniciar farm", UDim2.new(0, 10, 0, 40), C.startOn)
local stopBtn = actionButton("Parar farm", UDim2.new(0.5, 3, 0, 40), C.btn)
local statusLabel = mk("TextLabel", { Position = UDim2.fromOffset(10, 72), Size = UDim2.new(1, -20, 0, 26), BackgroundTransparency = 1, Text = "Pronto.",
	TextColor3 = C.muted, TextSize = 9, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true }, body)

-- Dropdown (irmão do corpo, ZIndex alto)
local list = mk("Frame", { Position = UDim2.fromOffset(10, HH + 8 + 28), Size = UDim2.new(1, -20, 0, 5 * 24 + 6),
	BackgroundColor3 = C.panel, BorderSizePixel = 0, Visible = false, ZIndex = 10 }, main)
corner(list, 7); stroke(list, C.accent)

local mission = 1
local function say(text, color) statusLabel.Text = text; statusLabel.TextColor3 = color or C.muted end

local function refresh()
	if Farm.running then
		local parts = {}
		for _, m in ipairs(Farm.mods) do
			if m == "lixo" then parts[#parts + 1] = "lixo " .. Farm.stats.coletados .. "/" .. Farm.stats.depositados
			elseif m == "grama" then parts[#parts + 1] = "grama " .. Farm.stats.cortadas
			else parts[#parts + 1] = "caixas " .. Farm.stats.caixas end
		end
		say("● " .. Farm.action .. "\n" .. table.concat(parts, " • "), C.green)
		startBtn.BackgroundColor3 = C.btn; stopBtn.BackgroundColor3 = C.stopOn
	else
		startBtn.BackgroundColor3 = C.startOn; stopBtn.BackgroundColor3 = C.btn
	end
	dot.Visible = Farm.running
end

local optButtons = {}
local function setMission(i)
