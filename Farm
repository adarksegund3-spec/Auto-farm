local Recorder = { active = nil }

local function snapshot()
	local s = {}
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	s.posicao = hrp and v3str(hrp.Position) or "não detectado"
	s.estado_humanoid = hum and tostring(hum:GetState()) or "não detectado"
	local function tools(container)
		local t = {}
		if container then
			for _, c in ipairs(container:GetChildren()) do
				if c:IsA("Tool") then t[#t + 1] = clean(c.Name) end
			end
		end
		table.sort(t)
		return #t > 0 and table.concat(t, ", ") or "nenhuma"
	end
	s.ferramentas_equipadas = tools(char)
	s.mochila = tools(LocalPlayer:FindFirstChildOfClass("Backpack"))
	local extra = {}
	if char then
		for _, c in ipairs(char:GetChildren()) do
			if c:IsA("Model") or c:IsA("Folder") or c:IsA("Configuration") then extra[#extra + 1] = clean(c.Name) .. " (" .. c.ClassName .. ")" end
		end
	end
	table.sort(extra)
	s.objetos_no_personagem = #extra > 0 and table.concat(extra, ", ") or "nenhum"
	local ls = LocalPlayer:FindFirstChild("leaderstats")
	if ls then
		local t = {}
		for _, v in ipairs(ls:GetChildren()) do
			if v:IsA("ValueBase") then t[#t + 1] = clean(v.Name) .. "=" .. tostring(cleanPrim(v.Value)) end
		end
		table.sort(t)
		s.leaderstats = #t > 0 and table.concat(t, "; ") or "vazio"
	else
		s.leaderstats = "não detectado"
	end
	local pa = attrStr(LocalPlayer)
	s.atributos_jogador = pa ~= "" and pa or "nenhum"
	local ca = char and attrStr(char) or ""
	s.atributos_personagem = ca ~= "" and ca or "nenhum"
	return s
end

local function describe(inst, ref)
	local info = { ref = ref, nome = "não detectado", classe = "não detectado" }
	pcall(function() info.nome = clean(inst.Name); info.classe = inst.ClassName end)
	info.caminho = pathOf(inst)
	local p, rp = posOf(inst), rootPos()
	info.posicao = p and v3str(p) or "não detectado"
	info.distancia = (p and rp) and string.format("%.1f", (p - rp).Magnitude) or "não detectado"
	info.atributos = attrStr(inst)
	return info
end

local function refOf(s, inst)
	local r = s.refs[inst]
	if r then return r end
	if s.objCount >= CFG.MAX_OBJECTS then s.limits.maxObjetos = true return nil end
	s.objCount += 1
	r = string.format("OBJ-%03d", s.objCount)
	s.refs[inst] = r
	s.order[#s.order + 1] = r
	s.objects[r] = describe(inst, r)
	return r
end

local function addEvent(s, kind, desc, inst, data)
	if s.closed then return end
	local cap = TYPE_CAPS[kind]
	if cap then
		s.typeCount[kind] = (s.typeCount[kind] or 0) + 1
		if s.typeCount[kind] > cap then
			s.limits["limite_" .. kind] = true
			return
		end
	end
	if #s.events >= CFG.MAX_EVENTS then
		s.limits.maxEventos = true
		return
	end
	local e = { n = #s.events + 1, t = math.floor((os.clock() - s.t0) * 100 + 0.5) / 100, tipo = kind, desc = trunc(desc, CFG.STR) }
	if inst then
		local r = refOf(s, inst)
		if r then
			e.ref = r
			s.counts[r] = (s.counts[r] or 0) + 1
			s.score[r] = (s.score[r] or 0) + (INTERACTION[kind] and 3 or 1)
		end
	end
	if data then
		local d = {}
		for k, v in pairs(data) do d[clean(k)] = cleanPrim(v) end
		e.dados = d
	end
	s.events[#s.events + 1] = e
end

local function isCharacterPart(d)
	local top = d
	while top.Parent and top.Parent ~= Workspace do top = top.Parent end
	return Players:GetPlayerFromCharacter(top) ~= nil
end
local function insideRecorded(s, d)
	local a = d.Parent
	while a and a ~= Workspace and a ~= game do
		if s.refs[a] then return true end
		a = a.Parent
	end
	return false
end

local function track(s, inst)
	if s.closed or not inst or s.trackedSet[inst] or inst == Workspace then return end
	if s.trackedCount >= CFG.MAX_TRACKED then s.limits.maxRastreados = true return end
	s.trackedSet[inst] = true
	s.trackedCount += 1
	refOf(s, inst)
	local p = posOf(inst)
	if p then s.objPos[inst] = p end
	local inGame = inst:IsDescendantOf(game)
	s.maid:add(inst.AncestryChanged:Connect(function(child)
		local now = inst:IsDescendantOf(game)
		if now ~= inGame then
			inGame = now
			addEvent(s, now and "hierarquia" or "removido", now and "Objeto reinserido na hierarquia" or "Objeto removido da hierarquia (fora do jogo)", inst)
		elseif child == inst then
			addEvent(s, "hierarquia", "Pai alterado para " .. pathOf(inst.Parent), inst)
		end
	end))
	s.maid:add(inst.AttributeChanged:Connect(function(name)
		addEvent(s, "atributo", "Atributo '" .. clean(name) .. "' = " .. tostring(cleanPrim(inst:GetAttribute(name))), inst)
	end))
	if inst:IsA("BasePart") then
		for _, prop in ipairs({ "Transparency", "CanCollide", "Anchored" }) do
			s.maid:add(inst:GetPropertyChangedSignal(prop):Connect(function()
				addEvent(s, "propriedade", prop .. " = " .. tostring(cleanPrim(inst[prop])), inst)
			end))
		end
	end
	if inst:IsA("ValueBase") then
		s.maid:add(inst.Changed:Connect(function(v)
			addEvent(s, "valor", inst.Name .. " = " .. tostring(cleanPrim(v)), inst)
		end))
	end
	if inst:IsA("Tool") then
		s.maid:add(inst.Equipped:Connect(function() addEvent(s, "ferramenta", "Tool equipada: " .. inst.Name, inst) end))
		s.maid:add(inst.Unequipped:Connect(function() addEvent(s, "ferramenta", "Tool desequipada: " .. inst.Name, inst) end))
		s.maid:add(inst.Activated:Connect(function() addEvent(s, "ferramenta", "Tool ativada (cliente): " .. inst.Name, inst) end))
	end
end

local function promptData(p)
	local d = {}
	pcall(function() d.acao = p.ActionText; d.objeto = p.ObjectText; d.hold = p.HoldDuration; d.distanciaMax = p.MaxActivationDistance end)
	return d
end

local function hookCharacter(s, char)
	if not char or s.closed then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		s.maid:add(hum.StateChanged:Connect(function(old, new)
			addEvent(s, "estado", "Humanoid: " .. tostring(old) .. " -> " .. tostring(new))
		end))
	end
	s.maid:add(char.ChildAdded:Connect(function(c)
		addEvent(s, "personagem_adic", "Adicionado ao personagem: " .. c.Name .. " (" .. c.ClassName .. ")", c)
		if c:IsA("Tool") or c:IsA("Model") then track(s, c) end
	end))
	s.maid:add(char.ChildRemoved:Connect(function(c)
		addEvent(s, "personagem_rem", "Removido do personagem: " .. c.Name .. " (" .. c.ClassName .. ")", c)
	end))
	s.maid:add(char.AttributeChanged:Connect(function(n)
		addEvent(s, "atributo", "Atributo do personagem '" .. clean(n) .. "' = " .. tostring(cleanPrim(char:GetAttribute(n))))
	end))
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Tool") then track(s, c) end
	end
end

local function pollSession(s)
	local rp = rootPos()
	if rp then
		s.lastPos = s.lastPos or rp
		local d = (rp - s.lastPos).Magnitude
		if d >= 8 then
			addEvent(s, "movimento", string.format("Personagem moveu %.1f studs", d), nil, { posicao = v3str(rp) })
			s.lastPos = rp
		end
	end
	for inst, last in pairs(s.objPos) do
		if inst:IsDescendantOf(game) and (s.objMoves[inst] or 0) < 15 then
			local p = posOf(inst)
			if p and (p - last).Magnitude >= 1 then
				s.objPos[inst] = p
				s.objMoves[inst] = (s.objMoves[inst] or 0) + 1
				addEvent(s, "movimento_obj", string.format("Objeto mudou de posição (%.1f studs)", (p - last).Magnitude), inst, { de = v3str(last), para = v3str(p) })
			end
		end
	end
end

local function logUiClick(s, input, ownGui)
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not pg then return end
	local objs = pg:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y)
	local top
	for _, o in ipairs(objs) do
		if not (ownGui and o:IsDescendantOf(ownGui)) and (o:IsA("GuiButton") or (o:IsA("TextLabel") and o.Text ~= "")) then
			top = o
			break
		end
	end
	if not top then return end
	local txt = (top:IsA("TextButton") or top:IsA("TextLabel")) and top.Text or ""
	addEvent(s, "clique_ui", "Toque/clique em UI do jogo: '" .. trunc(top.Name, 40) .. "'" .. (txt ~= "" and (" texto='" .. trunc(txt, 40) .. "'") or ""), top, { caminho = pathOf(top) })
end

local function setupSession(s, gui)
	local function hook(name, fn)
		local ok, err = pcall(fn)
		if not ok then s.fails[#s.fails + 1] = clean(name .. ": " .. trunc(err, 120)) end
	end
	hook("personagem", function()
