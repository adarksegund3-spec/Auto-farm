-- [5] RELATÓRIO (seções e texto copiável)
----------------------------------------------------------------------
local function fmtData(d)
	if type(d) ~= "table" then return "" end
	local keys = {}
	for k in pairs(d) do keys[#keys + 1] = tostring(k) end
	table.sort(keys)
	if #keys == 0 then return "" end
	local p = {}
	for _, k in ipairs(keys) do p[#p + 1] = k .. "=" .. tostring(d[k]) end
	return " {" .. table.concat(p, ", ") .. "}"
end

local function objLines(o)
	return {
		"Referência local: " .. tostring(o.ref) .. " (ID local da sessão; NÃO é identificador do jogo)",
		"Nome: " .. tostring(o.nome) .. " (nomes não são únicos)",
		"Classe: " .. tostring(o.classe),
		"Caminho: " .. tostring(o.caminho),
		"Posição ao ser registrado: " .. tostring(o.posicao),
		"Distância ao personagem: " .. tostring(o.distancia),
		"Atributos: " .. ((o.atributos and o.atributos ~= "") and o.atributos or "[INDISPONÍVEL] nenhum atributo"),
		"Eventos associados: " .. tostring(o.eventos or 0),
	}
end

local function buildSections(rec)
	local S = {}
	local function add(title, lines) S[#S + 1] = { title = title, lines = lines } end
	local objMap = {}
	for _, o in ipairs(rec.objetos) do objMap[o.ref] = o end

	add("1. Resumo da sessão", {
		"Nome: " .. rec.nome, "Categoria: " .. CATS[rec.categoria].label, "ID da gravação: " .. rec.id,
		"Início: " .. fmtDate(rec.startedAt), "Fim: " .. fmtDate(rec.endedAt),
		string.format("Duração: %.1fs", rec.duracao), "Eventos: " .. #rec.eventos,
		"Completude: " .. rec.completude, "Estado: " .. rec.estado,
		"Missão selecionada: " .. rec.missao, "Executor: " .. rec.executor, "PlaceId: " .. tostring(rec.placeId),
		"Legenda: [CAPTURADO] observado | [INFERIDO] hipótese | [INDISPONÍVEL] não fornecido pelo cliente",
		"Observação: salvar confirma a existência do registro, não a completude dos dados.",
	})
	local main = rec.objetoPrincipal and objMap[rec.objetoPrincipal]
	add("2. Objeto principal detectado", main and objLines(main) or { "[INDISPONÍVEL] Nenhum objeto principal pôde ser determinado." })
	local rel = {}
	for _, o in ipairs(rec.objetos) do
		if o.ref ~= rec.objetoPrincipal then
			rel[#rel + 1] = string.format("%s | %s (%s) | eventos: %d | dist.: %s", o.ref, o.nome, o.classe, o.eventos or 0, tostring(o.distancia))
		end
	end
	add("3. Objetos relacionados", #rel > 0 and rel or { "[INDISPONÍVEL] Nenhum objeto relacionado registrado." })
	local ids = {}
	for _, o in ipairs(rec.objetos) do
		ids[#ids + 1] = string.format("%s | %s | %s | atributos: %s", o.ref, o.nome, o.classe, (o.atributos and o.atributos ~= "") and o.atributos or "nenhum")
	end
	table.insert(ids, 1, "Obs.: ref. OBJ-xxx é só um ID local da sessão. Atributos listados vêm do próprio jogo.")
	add("4. Identificadores e classes disponíveis", ids)
	local paths = {}
	for _, o in ipairs(rec.objetos) do paths[#paths + 1] = o.ref .. " -> " .. tostring(o.caminho) end
	add("5. Caminhos hierárquicos", #paths > 0 and paths or { "[INDISPONÍVEL] Sem objetos registrados." })
	local evs = {}
	for _, e in ipairs(rec.eventos) do
		evs[#evs + 1] = string.format("E%03d  +%.2fs  [%s]  %s%s%s", e.n, e.t, e.tipo, e.ref and (e.ref .. " • ") or "", e.desc, fmtData(e.dados))
	end
	add("6. Eventos em ordem cronológica [CAPTURADO]", #evs > 0 and evs or { "Nenhum evento." })
	local props = {}
	for _, e in ipairs(rec.eventos) do
		if PROPERTY_TYPES[e.tipo] then
			props[#props + 1] = string.format("E%03d  +%.2fs  %s%s%s", e.n, e.t, e.ref and (e.ref .. " • ") or "", e.desc, fmtData(e.dados))
		end
	end
	add("7. Propriedades alteradas", #props > 0 and props or { "[INDISPONÍVEL] Nenhuma propriedade/atributo/valor alterado foi observado." })
	local st = { "ANTES / DEPOIS (posição inclui movimento normal do personagem):" }
	local keys = {}
	for k in pairs(rec.antes) do keys[#keys + 1] = k end
	for k in pairs(rec.depois) do if rec.antes[k] == nil then keys[#keys + 1] = k end end
	table.sort(keys)
	for _, k in ipairs(keys) do
		local a, b = tostring(rec.antes[k] or "não detectado"), tostring(rec.depois[k] or "não detectado")
		st[#st + 1] = string.format("%s: %s -> %s%s", k, a, b, a ~= b and "  (ALTERADO)" or "")
	end
	add("8. Estado anterior e posterior", st)
	local res = { "Resumo observado: " .. rec.estado }
	for _, d in ipairs(rec.diferencas) do res[#res + 1] = "[CAPTURADO] diferença: " .. d end
	for _, i in ipairs(rec.inferencias) do res[#res + 1] = i end
	add("9. Resultado observado", res)
	add("10. Dados não detectados e limitações", rec.limitacoes)
	return S
end

local function fullReport(rec)
	local out = { "=== AUTO FARM • DRIP MENU — RELATÓRIO TÉCNICO (by Angel) ===" }
	for _, sec in ipairs(buildSections(rec)) do
		out[#out + 1] = ""
		out[#out + 1] = "## " .. sec.title
		for _, l in ipairs(sec.lines) do out[#out + 1] = tostring(l) end
	end
	return table.concat(out, "\n")
end

local function copyText(text)
	local fn = setclipboard or toclipboard or (type(Clipboard) == "table" and Clipboard.set) or nil
	if type(fn) ~= "function" then return false end
	return pcall(fn, text)
end

