		executor = executorName(), placeId = game.PlaceId, falhas = {}, objetoPrincipal = best and best.ref or nil, diferencas = {},
		inferencias = inf, completude = completude,
		estado = string.format("%d candidata(s); melhor: %s.", #cand, best and best.ref or "nenhuma"),
		limitacoes = {
			"Detecção de ponto único: usa apenas a posição do jogador no instante do toque. Fique DENTRO da área marcada.",
			"A validação real da entrega ocorre no servidor; o cliente só enxerga peças replicadas.",
			"Se a área for um Decal/Texture, UI ou zona calculada só no servidor, pode não aparecer como peça candidata.",
			"Raio de busca: 14 studs; peças maiores que 250 studs sem TouchInterest são ignoradas (ex.: chão do mapa).",
