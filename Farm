local function fmtClock(sec) return string.format("%02d:%02d", math.floor(sec / 60), math.floor(sec % 60)) end
refreshRecording = function()
	local s = Recorder.active
	recDot.Visible = s ~= nil or Farm.running
	for cat, b in pairs(blocks) do
		if s and s.cat == cat then
			b.btn.Text = "Parar e salvar"; b.btn.BackgroundColor3 = Color3.fromRGB(110, 44, 48); b.btn.TextColor3 = C.text
			b.status.Text = string.format("● Gravando %s • %d evento(s). Execute a ação manualmente no jogo.", fmtClock(os.clock() - s.t0), #s.events)
			b.status.TextColor3 = C.red
		elseif s then
			b.btn.Text = "Indisponível"; b.btn.BackgroundColor3 = C.btn; b.btn.TextColor3 = C.muted
			b.status.Text = "Outra gravação está ativa: " .. CATS[s.cat].label .. ". Finalize-a primeiro."
			b.status.TextColor3 = C.amber
		elseif Farm.running then
			b.btn.Text = "Indisponível (farm ativo)"; b.btn.BackgroundColor3 = C.btn; b.btn.TextColor3 = C.muted
			b.status.Text = "Pare o farm para gravar."
			b.status.TextColor3 = C.amber
		else
			b.btn.Text = "Gravar"; b.btn.BackgroundColor3 = Color3.fromRGB(44, 74, 110); b.btn.TextColor3 = C.text
			b.status.Text = "Pronto para gravar."
			b.status.TextColor3 = C.muted
		end
	end
	relayout()
	if Farm.running then
		missionStatus.Text = string.format("● Farm %s • lixo %d/%d • grama %d • %s", Farm.kind or "", Farm.stats.coletados, Farm.stats.depositados, Farm.stats.cortadas, Farm.action)
		missionStatus.TextColor3 = C.green
	elseif s and missionKind() then
		missionStatus.Text = "Finalize a gravação para usar o farm."
		missionStatus.TextColor3 = C.amber
	else
		missionStatus.Text = missionStatusText(MISSIONS[state.mission])
		missionStatus.TextColor3 = C.muted
	end
	local dot = Storage.state == "confirmed" and "✔ " or (Storage.state == "memory" or Storage.state == "failed") and "! " or ""
	storageLabel.Text = "Armazenamento: " .. dot .. Storage.msg
end

local ticker = 0
local function startTicker(s)
	ticker += 1
	local my = ticker
	task.spawn(function()
		while Recorder.active == s and ticker == my do
			refreshRecording()
			task.wait(0.5)
		end
	end)
end

local farmTick = 0
startFarmTicker = function()
	farmTick += 1
	local my = farmTick
	task.spawn(function()
		while Farm.running and farmTick == my do
			refreshRecording()
			task.wait(0.25)
		end
		refreshRecording()
	end)
end

saveFlow = function(rec, cat)
	showModal({
		title = "Nomear gravação", text = "Categoria: " .. CATS[cat].label .. " • " .. #rec.eventos .. " evento(s) • dados " .. rec.completude .. ".",
		input = true, default = CATS[cat].label .. " " .. os.date("%H:%M:%S"), confirm = "Salvar",
		onConfirm = function(name)
			if rec.saved then return end
			rec.saved = true
			rec.nome = name
			local okA, msg = Records.add(rec)
			if not okA then rec.saved = false; rec.nome = nil; toast(msg); return end
			renderCards()
			refreshRecording()
			toast("Salvo em Diagnóstico. " .. msg)
		end,
		onCancel = function() toast("Gravação descartada (não salva).") end,
	})
end

local busy = false
local function handleBlock(cat)
	if busy then return end
	busy = true
	local ok, err = pcall(function()
		local s = Recorder.active
		if not s then
			if Farm.running then toast("Pare o farm antes de gravar.") return end
			local sess, e = Recorder.start(cat, MISSIONS[state.mission].label, gui)
			if not sess then toast(e) return end
			startTicker(sess)
			refreshRecording()
			toast("Gravando: " .. CATS[cat].label)
		elseif s.cat == cat then
			ticker += 1
			local rec, e = Recorder.stop()
			refreshRecording()
			if not rec then toast(e) return end
			saveFlow(rec, cat)
		else
			toast("Outra gravação está ativa.")
		end
	end)
	busy = false
	if not ok then toast("Erro: " .. trunc(err, 80)) end
end
