local function addTextChunks(parent, lines)
	local buf, size, total, omitted = {}, 0, 0, 0
	local function flush()
		if #buf > 0 then
			local l = label(parent, table.concat(buf, "\n"), 10, C.text)
			l.TextSelectable = true
			buf, size = {}, 0
		end
	end
	for i, line in ipairs(lines) do
		if total > 30000 then omitted = #lines - i + 1 break end
		line = tostring(line)
		if size + #line > 2800 then flush() end
		buf[#buf + 1] = line
		size += #line + 1
		total += #line + 1
	end
	flush()
	if omitted > 0 then label(parent, "… " .. omitted .. " linha(s) omitida(s) na tela. Use Copiar para o relatório completo.", 10, C.amber) end
end

local function buildSection(parent, title, fill)
	local wrap = mk("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.card, BorderSizePixel = 0 }, parent)
	corner(wrap, 8); vlist(wrap, 0)
	local head = mk("TextButton", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, AutoButtonColor = false, Text = "+  " .. title, TextColor3 = C.text,
		TextSize = 11, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, wrap)
	pad(head, 10, 0)
	local content = mk("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = false }, wrap)
	pad(content, 10, 4, 10, 10); vlist(content, 4)
	local built = false
	head.Activated:Connect(function()
		content.Visible = not content.Visible
		head.Text = (content.Visible and "-  " or "+  ") .. title
		if content.Visible and not built then
			built = true
			local ok, err = pcall(fill, content)
			if not ok then label(content, "Erro ao renderizar: " .. trunc(err, 80), 10, C.red) end
		end
	end)
end

openDetail = function(rec)
	detailRec = rec
	dTitle.Text = rec.nome
	dName.Text = rec.nome
	for _, c in ipairs(dScroll:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	local info = label(dScroll, CATS[rec.categoria].label .. " • " .. fmtDate(rec.startedAt) .. " • " .. #rec.eventos .. " evento(s) • dados " .. rec.completude, 10, C.muted)
	info.LayoutOrder = 0
	for _, sec in ipairs(buildSections(rec)) do
		buildSection(dScroll, sec.title, function(content) addTextChunks(content, sec.lines) end)
	end
	buildSection(dScroll, "11. Relatório técnico copiável", function(content)
		label(content, "O relatório completo (seções 1 a 10) é copiado em texto legível, sem depender de capturas de tela.", 10, C.muted)
		button(content, "Copiar relatório completo", UDim2.new(1, 0, 0, 30), function()
			if copyText(fullReport(rec)) then toast("Relatório copiado.") else toast("Este executor não oferece setclipboard.") end
		end)
	end)
	dScroll.CanvasPosition = Vector2.new(0, 0)
	detail.Visible = true
end

