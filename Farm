local uiMaid = newMaid()
local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function corner(o, r) return mk("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function stroke(o, col) return mk("UIStroke", { Color = col or C.stroke, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o) end
local function getGuiParent()
	if type(gethui) == "function" then
		local ok, h = pcall(gethui)
		if ok and typeof(h) == "Instance" then return h end
	end
	local ok, cg = pcall(function() return game:GetService("CoreGui") end)
	if ok and cg then
		local t = Instance.new("Folder")
		local ok2 = pcall(function() t.Parent = cg end)
		t:Destroy()
		if ok2 then return cg end
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local gui = mk("ScreenGui", { Name = "DripMenu" .. math.random(10000, 99999), ResetOnSpawn = false, IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999 }, getGuiParent())

local VIEW = viewport()
local W = math.min(200, math.max(180, VIEW.X - 16))
local HH, H = 28, 128
local main = mk("Frame", { Name = "Main", Size = UDim2.fromOffset(W, H), Position = UDim2.fromOffset(math.max(8, (VIEW.X - W) / 2), 12),
	BackgroundColor3 = C.bg, BorderSizePixel = 0, Active = true }, gui)
corner(main, 10); stroke(main)

-- Shimmer discreto
local shimClip = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 5, Active = false }, main)
corner(shimClip, 10)
local shimLine = mk("Frame", { Size = UDim2.new(0, 30, 1.6, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(-0.1, 0, 0.5, 0),
	Rotation = 18, BackgroundColor3 = C.accent, BorderSizePixel = 0, ZIndex = 5, Active = false }, shimClip)
mk("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.93), NumberSequenceKeypoint.new(1, 1) }) }, shimLine)
local shimTween = TweenService:Create(shimLine, TweenInfo.new(5, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1, false, 0), { Position = UDim2.new(1.1, 0, 0.5, 0) })
shimTween:Play()

-- Cabeçalho (arrasta por aqui)
local header = mk("Frame", { Size = UDim2.new(1, 0, 0, HH), BackgroundTransparency = 1 }, main)
mk("TextLabel", { Position = UDim2.fromOffset(10, 3), Size = UDim2.new(1, -50, 0, 14), BackgroundTransparency = 1, Text = "Auto farm • drip menu",
	TextColor3 = C.text, TextSize = 11, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left }, header)
mk("TextLabel", { Position = UDim2.fromOffset(10, 16), Size = UDim2.new(1, -50, 0, 10), BackgroundTransparency = 1, Text = "by angel",
	TextColor3 = C.muted, TextSize = 8, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left }, header)
mk("Frame", { Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = C.stroke, BorderSizePixel = 0 }, header)
local dot = mk("Frame", { Position = UDim2.new(1, -44, 0, 10), Size = UDim2.fromOffset(7, 7), BackgroundColor3 = C.green, BorderSizePixel = 0, Visible = false }, header)
corner(dot, 4)
local minBtn = mk("TextButton", { Position = UDim2.new(1, -28, 0, 4), Size = UDim2.fromOffset(20, 20), BackgroundColor3 = C.btn, AutoButtonColor = false,
	Text = "–", TextColor3 = C.text, TextSize = 13, Font = Enum.Font.GothamBold, BorderSizePixel = 0 }, header)
corner(minBtn, 6)

local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
uiMaid:add(header.InputBegan:Connect(function(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		dragging, dragInput, dragStart, startPos = true, input, input.Position, main.Position
		local c
		c = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				if c then c:Disconnect() end
			end
		end)
	end
end))
uiMaid:add(UserInputService.InputChanged:Connect(function(input)
	if not dragging then return end
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseMovement or (t == Enum.UserInputType.Touch and input == dragInput) then
		local d = input.Position - dragStart
		local v = viewport()
		main.Position = UDim2.fromOffset(math.clamp(startPos.X.Offset + d.X, -W + 60, v.X - 60), math.clamp(startPos.Y.Offset + d.Y, 0, v.Y - HH))
	end
end))

-- Corpo
local body = mk("Frame", { Position = UDim2.fromOffset(0, HH), Size = UDim2.new(1, 0, 1, -HH), BackgroundTransparency = 1 }, main)
local selector = mk("TextButton", { Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 0, 26), BackgroundColor3 = C.card, AutoButtonColor = false,
	Text = "", BorderSizePixel = 0 }, body)
corner(selector, 7); stroke(selector)
local selText = mk("TextLabel", { Position = UDim2.fromOffset(9, 0), Size = UDim2.new(1, -30, 1, 0), BackgroundTransparency = 1, Text = "",
	TextColor3 = C.text, TextSize = 11, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left }, selector)
mk("TextLabel", { Position = UDim2.new(1, -22, 0, 0), Size = UDim2.fromOffset(16, 26), BackgroundTransparency = 1, Text = "▼", TextColor3 = C.accent, TextSize = 8, Font = Enum.Font.Gotham }, selector)

